    "deviceUrl": {
      "default": "",
      "description": "One device for mode=deviceDetails. Accepts a full GSMArena URL, a slug, or a numeric device ID. Example: `samsung_galaxy_s25_ultra-13322`.",
      "editor": "textfield",
      "prefill": "samsung_galaxy_s25_ultra-13322",
      "title": "Device URL, slug or ID",
      "type": "string"
    },
    "deviceUrls": {
      "default": [],
      "description": "Additional devices for mode=deviceDetails. The single field above and this list are combined and deduplicated.",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "prefill": [],
      "title": "Device URLs, slugs or IDs",
      "type": "array"
    },
    "includeDetails": {
      "default": false,
      "description": "For search, brand and ranking modes, open each device page and return the complete spec sheet instead of the listing summary. Slower and capped; deviceDetails mode always returns full specs.",
      "editor": "checkbox",
      "prefill": false,
      "title": "Include full spec sheets",
      "type": "boolean"
    },
    "maxItems": {
      "default": 20,
      "description": "Maximum records to return. Brand searches can span thousands of devices; spec-sheet enrichment is capped to keep runs reliable.",
      "maximum": 2000,
      "minimum": 1,
      "prefill": 1,
      "title": "Max items",
      "type": "integer"
    },
    "mode": {
      "default": "search",
      "description": "What to collect: a keyword search, one or more full spec sheets, every device from a brand, the current rankings, or the list of brands.",
      "editor": "select",
      "enum": [
        "search",
        "deviceDetails",
        "byBrand",
        "topDevices",
        "brands"
      ],
      "enumTitles": [
        "Search devices by keyword",
        "Full spec sheets for device URLs/IDs",
        "All devices from one brand",
        "Top devices by popularity",
        "List all brands"
      ],
      "prefill": "deviceDetails",
      "title": "Mode",
      "type": "string"
    },
    "osFilter": {
      "default": "any",
      "description": "Keep only devices with this OS (mode=search). Filtering by OS reads spec sheets, so it is slower than a plain search.",
      "editor": "select",
      "enum": [
        "any",
        "android",
        "ios",
        "featurePhone",
        "kaios",
        "windowsPhone",
        "symbian",
        "blackberry",
        "bada",
        "firefoxos"
      ],
      "enumTitles": [
        "Any OS",
        "Android",
        "iOS",
        "Feature phones",
        "KaiOS",
        "Windows Phone",
        "Symbian",
        "BlackBerry",
        "Bada",
        "Firefox OS"
      ],
      "prefill": "any",
      "title": "Operating system",
      "type": "string"
    },
    "searchQuery": {
      "default": "",
      "description": "Keyword matched against device names, aliases and URLs (mode=search). Leave empty to browse the catalog from the newest/popular end. Example: `Samsung Galaxy S25`.",
      "editor": "textfield",
      "prefill": "",
      "title": "Search query",
      "type": "string"
    },
    "sortBy": {
      "default": "popularity",
      "description": "Result order. Price, weight, camera and battery sorting reads spec sheets and is slower; missing values go last.",
      "editor": "select",
      "enum": [
        "popularity",
        "newest",
        "price",
        "weight",
        "camera",
        "battery"
      ],
      "enumTitles": [
        "Popularity / catalog relevance",
        "Newest first",
        "Lowest price first",
        "Lightest first",
        "Highest rear-camera resolution",
        "Largest battery"
      ],
      "prefill": "popularity",
      "title": "Sort order",
      "type": "string"
    },
    "topChart": {
      "default": "daily",
      "description": "Which GSMArena homepage ranking to use (mode=topDevices).",
      "editor": "select",
      "enum": [
        "daily",
        "fans"
      ],
      "enumTitles": [
        "Top 10 by daily interest",
        "Top 10 by fans"
      ],
      "prefill": "daily",
      "title": "Ranking chart",
      "type": "string"
    }
  },
  "required": [
    "mode"
  ],
  "schemaVersion": 1,
  "title": "GSMArena Scraper Input",
  "type": "object"
}
