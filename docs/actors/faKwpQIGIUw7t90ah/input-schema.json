      "minimum": 1,
      "prefill": 3,
      "title": "Maximum doctors",
      "type": "integer"
    },
    "minConsultationFee": {
      "default": 0,
      "description": "Only include doctors whose lowest listed consultation fee is at least this amount in Indian rupees. Set 0 for no minimum.",
      "maximum": 1000000,
      "minimum": 0,
      "prefill": 0,
      "title": "Minimum consultation fee (INR)",
      "type": "integer"
    },
    "minExperienceYears": {
      "default": 0,
      "description": "Only include doctors with at least this many years of experience. Set 0 for no minimum.",
      "maximum": 60,
      "minimum": 0,
      "prefill": 0,
      "title": "Minimum experience (years)",
      "type": "integer"
    },
    "minPatientStories": {
      "default": 0,
      "description": "Only include doctors with at least this many patient stories (reviews). Set 0 for no minimum.",
      "maximum": 1000000,
      "minimum": 0,
      "prefill": 0,
      "title": "Minimum patient stories",
      "type": "integer"
    },
