      "type": "string"
    },
    "includePhone": {
      "default": false,
      "description": "Add the clinic call-routing phone number Practo shows behind Contact Clinic, plus the extension when one exists. Uses one extra request per clinic.",
      "prefill": false,
      "title": "Include phone number",
      "type": "boolean"
    },
    "includeProfileDetails": {
      "default": false,
      "description": "Fetch each doctor's profile page for registration numbers, languages, awards, memberships and work history. Uses one extra request per doctor.",
      "prefill": false,
      "title": "Include full profile details",
      "type": "boolean"
    },
    "includeServices": {
      "default": false,
      "description": "Add the treatments and services Practo lists for each doctor.",
      "prefill": false,
      "title": "Include services",
      "type": "boolean"
    },
    "includeSummary": {
      "default": false,
      "description": "Add the doctor-written profile summary when Practo publishes one.",
      "prefill": false,
      "title": "Include doctor summary",
      "type": "boolean"
    },
    "maxConsultationFee": {
      "default": 0,
      "description": "Only include doctors whose lowest listed consultation fee is at most this amount in Indian rupees. Set 0 for no maximum.",
      "maximum": 1000000,
      "minimum": 0,
      "prefill": 0,
      "title": "Maximum consultation fee (INR)",
      "type": "integer"
    },
    "maxItems": {
      "default": 30,
      "description": "Maximum number of doctor records to return. Practo exposes up to 500 doctors per city and specialty search (50 pages of 10).",
