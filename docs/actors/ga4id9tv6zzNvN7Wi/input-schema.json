{
  "description": "Search Trade Me Property for residential listings for sale or rent across New Zealand. No API credentials required.",
  "properties": {
    "maxBedrooms": {
      "description": "Maximum number of bedrooms.",
      "maximum": 10,
      "minimum": 1,
      "title": "Maximum Bedrooms",
      "type": "integer"
    },
    "maxItems": {
      "default": 50,
      "description": "Maximum number of listings to return.",
      "maximum": 5000,
      "minimum": 1,
      "prefill": 50,
      "title": "Max Items",
      "type": "integer"
    },
    "maxPrice": {
      "description": "Maximum listing price in New Zealand dollars.",
      "maximum": 50000000,
      "minimum": 0,
      "title": "Maximum Price (NZD)",
      "type": "integer"
    },
    "minBathrooms": {
      "description": "Minimum number of bathrooms.",
      "maximum": 10,
      "minimum": 1,
      "title": "Minimum Bathrooms",
      "type": "integer"
    },
    "minBedrooms": {
      "description": "Minimum number of bedrooms.",
      "maximum": 10,
      "minimum": 1,
      "title": "Minimum Bedrooms",
      "type": "integer"
    },
    "minPrice": {
      "description": "Minimum listing price in New Zealand dollars.",
      "maximum": 50000000,
      "minimum": 0,
      "title": "Minimum Price (NZD)",
      "type": "integer"
    },
    "mode": {
      "default": "searchForSale",
      "description": "What to scrape: residential properties for sale, rental listings, or enrich specific listing URLs.",
      "editor": "select",
      "enum": [
        "searchForSale",
        "searchForRent",
        "byListingUrls"
      ],
      "enumTitles": [
        "Search properties for sale",
        "Search rental listings",
        "Enrich specific listing URLs"
      ],
      "prefill": "searchForSale",
      "title": "Mode",
      "type": "string"
    },
    "propertyType": {
      "default": "",
      "description": "Type of property to filter results.",
      "editor": "select",
      "enum": [
        "",
        "house",
        "townhouse",
        "apartment",
        "unit",
        "section",
        "lifestyle",
        "rural",
        "newdevelopment",
        "carpark"
      ],
      "enumTitles": [
        "All types",
        "House",
        "Townhouse",
        "Apartment",
        "Unit",
        "Section / Land",
        "Lifestyle",
        "Rural",
        "New Development",
        "Carpark"
      ],
      "prefill": "",
      "title": "Property Type",
      "type": "string"
    },
    "region": {
      "default": "Auckland",
      "description": "New Zealand region to search. Use 'All New Zealand' for nationwide results.",
      "editor": "select",
      "enum": [
        "Auckland",
        "Bay of Plenty",
        "Canterbury",
        "Gisborne",
        "Hawke's Bay",
        "Manawatu / Whanganui",
        "Marlborough",
        "Nelson / Tasman",
        "Northland",
        "Otago",
        "Southland",
        "Taranaki",
        "Waikato",
        "Wellington",
        "West Coast",
        "All New Zealand"
      ],
      "enumTitles": [
        "Auckland",
        "Bay of Plenty",
        "Canterbury",
        "Gisborne",
        "Hawke's Bay",
        "Manawatu / Whanganui",
        "Marlborough",
        "Nelson / Tasman",
        "Northland",
        "Otago",
        "Southland",
        "Taranaki",
        "Waikato",
        "Wellington",
        "West Coast",
        "All New Zealand"
      ],
      "prefill": "Auckland",
      "title": "Region",
      "type": "string"
    },
    "startUrls": {
      "default": [],
      "description": "Trade Me property listing URLs to enrich, e.g. https://www.trademe.co.nz/a/property/residential/sale/listing/12345678",
      "editor": "stringList",
      "prefill": [],
      "title": "Listing URLs (mode=byListingUrls)",
      "type": "array"
    }
  },
  "required": [
    "mode"
  ],
  "schemaVersion": 1,
  "title": "Trade Me Property Scraper Input",
  "type": "object"
}
