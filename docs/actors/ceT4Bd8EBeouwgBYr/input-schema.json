      "enum": [
        "main",
        "decorating",
        "organizing",
        "diy",
        "shopping",
        "small-spaces",
        "kitchen",
        "bathroom",
        "bedroom",
        "living-room",
        "house-tours",
        "before-and-after",
        "news"
      ],
      "enumTitles": [
        "All (Main Feed)",
        "Decorating",
        "Organizing",
        "DIY",
        "Shopping",
        "Small Spaces",
        "Kitchen",
        "Bathroom",
        "Bedroom",
        "Living Room",
        "House Tours",
        "Before & After",
        "News"
      ],
      "title": "Category",
      "type": "string"
    },
    "maxItems": {
      "default": 50,
      "description": "Maximum number of articles to return (1–200).",
