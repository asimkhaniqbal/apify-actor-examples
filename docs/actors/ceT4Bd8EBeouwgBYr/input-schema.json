      "enumTitles": [
        "Get Latest Articles",
        "Search Articles by Keyword",
        "Browse by Category"
      ],
      "prefill": "getLatest",
      "title": "Scraping Mode",
      "type": "string"
    },
    "query": {
      "description": "Keyword(s) to search for in article titles, summaries, and tags. Used when mode=searchArticles.",
      "editor": "textfield",
      "prefill": "small apartment ideas",
      "title": "Search Query",
      "type": "string"
    }
  },
  "required": [],
  "schemaVersion": 1,
  "title": "Apartment Therapy Scraper Input",
