{
  "description": "Look up ads shown through Google by advertiser ID or landing-page domain.",
  "properties": {
    "adFormat": {
      "default": "",
      "description": "Restrict to a single ad format. Leave unset for all formats.",
      "editor": "select",
      "enum": [
        "",
        "TEXT",
        "IMAGE",
        "VIDEO"
      ],
      "enumTitles": [
        "All formats",
        "Text",
        "Image",
        "Video"
      ],
      "prefill": "",
      "title": "Ad format filter",
      "type": "string"
    },
    "advertiserIds": {
      "default": [],
      "description": "Exact Google Ads Transparency Center advertiser IDs, e.g. `AR16735076323512287233`. Find one via mode=byQuery first, or from a `adstransparency.google.com/advertiser/...` URL.",
      "editor": "stringList",
      "prefill": [],
      "title": "Advertiser IDs (mode=byAdvertiserId)",
      "type": "array"
    },
    "dateFrom": {
      "description": "Only keep ads last shown on/after this date.",
      "editor": "textfield",
      "title": "Last shown from (YYYY-MM-DD)",
      "type": "string"
    },
    "dateTo": {
      "description": "Only keep ads last shown on/before this date.",
      "editor": "textfield",
      "title": "Last shown to (YYYY-MM-DD)",
      "type": "string"
    },
    "maxItems": {
      "default": 40,
      "description": "Hard cap on emitted records. The upstream API serves at most 100 ads per lookup (no working pagination cursor is exposed publicly).",
      "maximum": 100,
      "minimum": 1,
      "prefill": 40,
      "title": "Max items",
      "type": "integer"
    },
    "mode": {
      "default": "byQuery",
      "description": "How to look up ads.",
      "editor": "select",
      "enum": [
        "byQuery",
        "byAdvertiserId"
      ],
      "enumTitles": [
        "Search by advertiser name or domain",
        "Lookup by exact advertiser ID(s)"
      ],
      "prefill": "byQuery",
      "title": "Mode",
      "type": "string"
    },
    "platform": {
      "default": "",
      "description": "Restrict to ads shown on a single Google surface. Leave unset for all platforms.",
      "editor": "select",
      "enum": [
        "",
        "SEARCH",
        "MAPS",
        "SHOPPING",
        "PLAY",
        "YOUTUBE"
      ],
      "enumTitles": [
        "All platforms",
        "Google Search",
        "Google Maps",
        "Google Shopping",
        "Google Play",
        "YouTube"
      ],
      "prefill": "",
      "title": "Platform filter",
      "type": "string"
    },
    "proxyConfiguration": {
      "default": {
        "useApifyProxy": true
      },
      "description": "The Ads Transparency RPC endpoint occasionally bot-checks (302) requests from a given datacenter IP, especially for mode=byAdvertiserId. This actor retries failed requests through Apify's free AUTO datacenter proxy group (a fresh IP per retry) — no paid/residential proxy is required.",
      "editor": "proxy",
      "prefill": {
        "useApifyProxy": true
      },
      "title": "Proxy configuration",
      "type": "object"
    },
    "query": {
      "default": "nike.com",
      "description": "A landing-page domain, e.g. `nike.com`. The upstream endpoint reliably matches domains; free-text brand names (e.g. `Nike`) frequently return zero results, so a domain is strongly recommended. For a name-independent lookup, find the `advertiserId` from a first byQuery run and reuse it with mode=byAdvertiserId.",
      "editor": "textfield",
      "prefill": "nike.com",
      "title": "Landing-page domain (mode=byQuery)",
      "type": "string"
    },
    "region": {
      "default": "US",
