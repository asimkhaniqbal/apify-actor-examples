    "location": {
      "description": "One reverse-geocoding point as {\"lat\": 40.7484, \"lng\": -73.9857}. Decimal degrees, WGS84.",
      "editor": "json",
      "sectionCaption": "Reverse geocoding",
      "sectionDescription": "Paste decimal coordinates. Google returns the nearest address or named place, plus the distance from your point.",
      "title": "Coordinates (single)",
      "type": "object"
    },
    "locations": {
      "description": "A list of reverse-geocoding points. Each item is {\"lat\": 40.7484, \"lng\": -73.9857} or a \"lat,lng\" string.",
      "editor": "json",
      "items": {
        "type": "object"
      },
      "title": "Coordinates (batch)",
      "type": "array"
    },
    "mode": {
      "description": "Forward turns an address, place name or postal code into coordinates. Reverse turns a coordinate pair into the nearest address. Place ID resolves a Google Place ID or Maps URL. Mixed processes every list in one run.",
      "editor": "select",
      "enum": [
        "forward",
        "reverse",
        "placeId",
        "mixed"
      ],
      "enumTitles": [
        "Forward: address/place -> coordinates",
        "Reverse: coordinates -> address",
        "Place ID or Google Maps URL -> address",
        "Mixed batch: all three lists in one run"
      ],
      "prefill": "forward",
      "sectionCaption": "What to geocode",
      "sectionDescription": "Pick the lookup direction, then fill the matching list. Addresses, coordinates and Place IDs can also be mixed in one run when mode is omitted.",
      "title": "Mode",
      "type": "string"
    },
    "placeId": {
      "description": "One Google Place ID (starts with ChIJ) or a full Google Maps place URL. Returns the place's address, coordinates and structured components.",
      "editor": "textfield",
      "sectionCaption": "Place ID lookup",
      "sectionDescription": "Use a Place ID copied from Google Maps or a Maps place URL. Bare legacy feature IDs are not supported.",
      "title": "Place ID or Google Maps URL (single)",
      "type": "string"
    },
    "placeIds": {
      "description": "One Google Place ID or Google Maps place URL per line.",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "title": "Place IDs or Google Maps URLs (batch)",
      "type": "array"
    }
