{
  "properties": {
    "historyDays": {
      "default": 15,
      "description": "[profiles] How many daily history snapshots to request (1-31). SocialBlade exposes at most 31 days without a login.",
      "editor": "number",
      "maximum": 31,
      "minimum": 1,
      "prefill": 15,
      "title": "History days",
      "type": "integer"
    },
    "includeHistory": {
      "default": true,
      "description": "[profiles] Include daily snapshots of followers/subscribers, views, videos and other platform metrics. Instagram history is login-only and is omitted.",
      "prefill": true,
      "title": "Include daily history",
      "type": "boolean"
    },
    "includeMilestones": {
      "default": false,
      "description": "[profiles] Also fetch YouTube subscriber/view/upload milestones and the first-tracked date. Adds one request per YouTube profile.",
      "prefill": false,
      "title": "Include YouTube milestones",
      "type": "boolean"
    },
    "maxItems": {
      "default": 50,
      "description": "Maximum records returned across all modes.",
      "editor": "number",
      "maximum": 5000,
      "minimum": 1,
      "prefill": 2,
      "title": "Max items",
      "type": "integer"
    },
    "mode": {
      "default": "profiles",
      "description": "What to do: look up specific creators (profiles), search creators by keyword, or pull a YouTube top/worst/growth/decline list.",
      "editor": "select",
      "enum": [
        "profiles",
        "youtube_rankings",
        "search"
      ],
      "enumTitles": [
        "Creator profile lookups",
        "YouTube rankings",
        "Creator search"
      ],
      "prefill": "profiles",
      "title": "Mode",
      "type": "string"
    },
    "platform": {
      "default": "youtube",
      "description": "[profiles] Platform used when a Profiles entry is a bare username string.",
      "editor": "select",
      "enum": [
        "youtube",
        "tiktok",
        "instagram",
        "twitch",
        "facebook"
      ],
      "enumTitles": [
        "YouTube",
        "TikTok",
        "Instagram",
        "Twitch",
        "Facebook"
      ],
      "prefill": "youtube",
      "title": "Default platform for bare usernames",
      "type": "string"
    },
    "profiles": {
      "description": "[profiles] Alternative to Start URLs: a list of {platform, username} objects or bare usernames.",
      "editor": "json",
      "title": "Profiles (alternative to URLs)",
      "type": "array"
    },
