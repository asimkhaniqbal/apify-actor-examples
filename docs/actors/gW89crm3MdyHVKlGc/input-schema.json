        "Owner name",
        "Business name",
        "Expiration date"
      ],
      "prefill": "licenseNumber",
      "title": "Sort order",
      "type": "string"
    },
    "statusFilter": {
      "default": "",
      "description": "Only emit licenses that are currently active or expired, based on the license expiration date. Leave unset for both.",
