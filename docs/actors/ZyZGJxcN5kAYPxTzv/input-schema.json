      "title": "Photography style",
      "type": "string"
    },
    "priceRange": {
      "default": "any",
      "description": "Filter by the vendor's published starting price.",
      "editor": "select",
      "enum": [
        "any",
        "under-1000",
        "1000-1750",
        "1750-2500",
        "2500-3500",
        "3500-plus"
