        "Mansions",
        "Parks",
        "Wineries & breweries",
        "Museums",
        "Churches & temples",
        "Rooftops & lofts",
        "Waterfronts",
        "Boats",
        "Gardens",
        "Beaches"
      ],
      "prefill": "photographers",
      "title": "Vendor category",
      "type": "string"
    },
    "city": {
      "default": "los-angeles",
      "description": "Optional city, e.g. `los-angeles` or `Los Angeles`. Leave empty to search the whole state.",
      "editor": "textfield",
      "prefill": "los-angeles",
      "title": "City or town",
      "type": "string"
    },
    "diversity": {
      "default": "any",
      "description": "Filter for a specific vendor-owned diversity group.",
      "editor": "select",
      "enum": [
        "any",
        "black-owned",
        "asian-owned",
        "hispanic-latinx-owned",
        "lgbtq-owned",
        "native-american-owned",
        "pacific-islander-owned",
        "veteran-owned",
        "woman-owned"
      ],
      "enumTitles": [
        "Any vendor",
        "Black-owned",
        "Asian-owned",
        "Hispanic or Latinx-owned",
        "LGBTQ+-owned",
        "Native American-owned",
        "Pacific Islander-owned",
        "Veteran-owned",
        "Woman-owned"
      ],
      "title": "Vendor diversity",
      "type": "string"
    },
    "includeDetails": {
      "default": true,
      "description": "Open each vendor's profile to add phone, website, description, photos, awards and social links. Adds one request per vendor.",
      "prefill": false,
      "sectionCaption": "Profile enrichment",
      "title": "Fetch full profiles",
      "type": "boolean"
    },
    "includeReviews": {
      "default": false,
      "description": "Add up to 25 recent reviews (author, rating, date, text) to each enriched profile. Adds one request per vendor.",
      "prefill": false,
      "title": "Fetch recent reviews",
      "type": "boolean"
    },
    "maxItems": {
      "default": 20,
      "description": "Hard cap on records. WeddingWire serves at most 500 vendors per search; larger state-wide requests are split by region automatically.",
      "maximum": 1000,
      "minimum": 1,
      "prefill": 3,
      "title": "Max vendors",
      "type": "integer"
    },
    "minRating": {
      "default": 0,
      "description": "Drop vendors rated below this value. Set to 0 to keep unrated vendors.",
      "maximum": 5,
      "minimum": 0,
      "title": "Minimum rating",
      "type": "number"
    },
    "mode": {
      "default": "searchVendors",
      "description": "Search the directory by category and location, or fetch full profiles for specific vendor URLs.",
      "editor": "select",
      "enum": [
        "searchVendors",
        "vendorDetails"
      ],
      "enumTitles": [
        "Search vendors by category and location",
        "Get full profiles for specific vendor URLs"
      ],
      "prefill": "searchVendors",
      "sectionCaption": "What to scrape",
      "title": "Mode",
      "type": "string"
    },
    "photographyService": {
      "default": "any",
      "description": "Optional service filter, applied only when category is Photographers.",
      "editor": "select",
      "enum": [
        "any",
        "additional-hours",
        "boudoir-shoot",
        "destination-travel",
        "engagement-shoot",
        "high-res-images",
        "one-event-day",
        "second-shooter",
        "video",
        "wedding-portraits"
      ],
      "enumTitles": [
        "Any service",
        "Additional hours",
        "Boudoir shoot",
        "Destination / travel",
        "Engagement shoot",
        "High-res images",
        "One event / day",
        "Second shooter",
        "Video",
        "Wedding portraits"
      ],
      "title": "Photography service",
      "type": "string"
    },
    "photographyStyle": {
      "default": "any",
      "description": "Optional style filter, applied only when category is Photographers.",
      "editor": "select",
      "enum": [
        "any",
        "contemporary",
        "film",
        "natural",
        "photojournalism",
        "traditional",
        "vintage"
