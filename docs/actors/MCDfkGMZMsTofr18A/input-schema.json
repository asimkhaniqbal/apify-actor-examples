    "maxItems": {
      "default": 50,
      "description": "Hard cap on emitted records.",
      "maximum": 1000,
      "minimum": 1,
      "prefill": 15,
      "title": "Max items",
      "type": "integer"
    },
    "maxPrice": {
      "description": "Exclude products with price above this value (storefront currency).",
      "editor": "number",
      "maximum": 100000,
      "minimum": 0,
      "title": "Maximum price",
      "type": "integer"
    },
    "minPrice": {
      "description": "Exclude products with price below this value (storefront currency).",
      "editor": "number",
      "maximum": 100000,
      "minimum": 0,
      "title": "Minimum price",
      "type": "integer"
    },
    "minRating": {
      "description": "Exclude products rated below this value (0–5). Products with no rating are kept.",
      "editor": "number",
      "maximum": 5,
      "minimum": 0,
      "title": "Minimum customer rating",
      "type": "integer"
    },
    "mode": {
      "default": "search",
      "description": "How to find products.",
      "editor": "select",
      "enum": [
        "search",
        "byProductIds",
        "byUrls",
        "byCategory"
      ],
      "enumTitles": [
        "Search by keyword",
        "Lookup by product ID",
        "Fetch from product URLs",
        "Browse a category"
      ],
      "prefill": "search",
      "title": "Mode",
      "type": "string"
    },
    "productIds": {
      "default": [],
      "description": "IKEA 8-digit article numbers (e.g. `20522046`, `00263850`). Dots/spaces allowed; we normalize. One ID per line.",
      "editor": "stringList",
      "prefill": [],
      "title": "Product IDs (mode=byProductIds)",
      "type": "array"
    },
    "productUrls": {
      "default": [],
      "description": "Full IKEA product page URLs, e.g. `https://www.ikea.com/us/en/p/billy-bookcase-white-20522046/`. One URL per line.",
      "editor": "stringList",
      "prefill": [],
      "title": "Product URLs (mode=byUrls)",
      "type": "array"
    },
    "searchQuery": {
      "default": "bookcase",
      "description": "Free-text search query, e.g. `bookcase`, `BILLY`, `sofa`. Searches the IKEA storefront for the selected country/language.",
      "editor": "textfield",
      "prefill": "bookcase",
      "title": "Search query (mode=search)",
      "type": "string"
    },
    "sortBy": {
      "default": "RELEVANCE",
      "description": "Sort order applied at the IKEA API level.",
      "editor": "select",
      "enum": [
        "RELEVANCE",
        "PRICE_LOW_TO_HIGH",
        "PRICE_HIGH_TO_LOW",
        "NEWEST",
        "RATING",
        "MOST_POPULAR",
        "NAME_ASCENDING",
        "WIDTH",
        "HEIGHT",
        "DEPTH"
      ],
      "enumTitles": [
        "Best match (relevance)",
        "Price: low to high",
        "Price: high to low",
        "Newest first",
        "Customer rating",
        "Most popular",
        "Name (A → Z)",
        "Width",
        "Height",
        "Depth"
      ],
      "prefill": "RELEVANCE",
      "title": "Sort by",
      "type": "string"
    }
  },
  "required": [
    "mode"
  ],
  "schemaVersion": 1,
  "title": "IKEA Scraper Input",
  "type": "object"
}
