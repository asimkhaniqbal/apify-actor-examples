            "label": "Found"
          },
          "sitesAvailable": {
            "format": "number",
            "label": "Available"
          },
          "sitesBlocked": {
            "format": "number",
            "label": "Blocked"
          },
          "sitesChecked": {
            "format": "number",
            "label": "Checked"
          },
          "sitesUnknown": {
            "format": "number",
            "label": "Unknown"
          },
          "username": {
            "format": "text",
            "label": "Username"
          }
        }
      },
      "title": "By Username",
      "transformation": {
        "fields": [
          "username",
          "links",
          "profilesFound",
          "sitesChecked",
          "sitesAvailable",
          "sitesBlocked",
          "sitesUnknown"
        ]
      }
    },
    "hits": {
