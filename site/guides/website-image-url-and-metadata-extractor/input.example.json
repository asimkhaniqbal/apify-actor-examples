{
  "acceptExtensionlessImages": true,
  "crawlSitemapPages": false,
  "excludeTrackingPixels": true,
  "fetchExternalStylesheets": false,
  "fetchImageMetadata": false,
  "followPagination": false,
  "imageExtensions": [
    "jpg",
    "jpeg",
    "png",
    "gif",
    "webp",
    "svg",
    "avif",
    "bmp",
    "ico"
  ],
  "includeBackgroundImages": true,
  "includeIcons": true,
  "includeMetaImages": true,
  "includeSrcset": true,
  "includeSubdomains": false,
  "maxCrawlDepth": 0,
  "maxImagesPerPage": 20,
  "maxPages": 1,
  "maxTotalImages": 10,
  "metadataConcurrency": 5,
  "minHeight": 0,
  "minWidth": 0,
  "mode": "crawl",
  "requestTimeoutSecs": 20,
  "requireAltText": false,
  "sameHostOnly": true,
  "startUrls": [
    "https://books.toscrape.com/"
  ]
}
