      "prefill": [],
      "title": "Locations",
      "type": "array"
    },
    "maxConcurrency": {
      "default": 5,
      "description": "How many business profiles to fetch at the same time. Lower it if you see rate limiting.",
      "maximum": 20,
      "minimum": 1,
      "prefill": 5,
      "title": "Parallel profile requests",
      "type": "integer"
    },
    "maxItems": {
      "default": 50,
      "description": "Hard cap on the number of business records emitted.",
      "maximum": 1000,
      "minimum": 1,
      "prefill": 3,
      "title": "Max items",
      "type": "integer"
    },
    "maxPages": {
