    "buildState": {
      "default": [],
      "description": "Only include listings in one of the selected building conditions.",
      "editor": "select",
      "items": {
        "enum": [
          "first_time_use",
          "mint_condition",
          "well_kept",
          "modernised",
          "fully_renovated",
          "partly_renovated",
          "refurbished",
          "need_of_renovation",
          "projected"
        ],
        "enumTitles": [
          "First occupancy",
          "Mint condition",
          "Well kept",
          "Modernised",
          "Fully renovated",
          "Partly renovated",
          "Refurbished",
          "Needs renovation",
          "Planned / under construction"
        ],
        "type": "string"
      },
      "prefill": [],
      "title": "Building condition",
      "type": "array"
    },
    "city": {
      "default": "Berlin",
      "description": "German city or town, for example Berlin, Muenchen, Hamburg, Koeln or Frankfurt am Main. Any place Immowelt indexes can be used.",
