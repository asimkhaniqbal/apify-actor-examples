    "includeDetails": {
      "default": false,
      "description": "Fetch each listing's exposé page to add construction year, heating, energy consumption, coordinates, amenities, price breakdown, documents and the full description. Adds one request per listing.",
      "prefill": false,
      "title": "Include exposé details",
      "type": "boolean"
    },
    "includeKeywords": {
      "default": [],
      "description": "Keep only listings whose title or description contains every listed keyword (case-insensitive).",
      "editor": "stringList",
      "prefill": [],
      "title": "Include keywords",
      "type": "array"
    },
    "maxArea": {
      "description": "Maximum living space in square metres.",
      "maximum": 10000000,
      "minimum": 0,
      "title": "Maximum living space (m2)",
      "type": "integer"
    },
    "maxBedrooms": {
      "description": "Largest number of bedrooms to include.",
      "maximum": 20,
      "minimum": 0,
      "title": "Maximum bedrooms",
      "type": "integer"
    },
    "maxDetails": {
      "default": 0,
      "description": "How many emitted listings get exposé enrichment. 0 means all emitted listings.",
      "maximum": 10000,
      "minimum": 0,
      "prefill": 0,
      "title": "Maximum detailed listings",
      "type": "integer"
    },
    "maxItems": {
      "default": 100,
      "description": "Hard cap on emitted listings. Full result sets are paginated, so values up to 10,000 are supported.",
      "maximum": 10000,
      "minimum": 1,
      "prefill": 5,
      "title": "Maximum items",
      "type": "integer"
    },
    "maxPlotArea": {
      "description": "Maximum plot or land size in square metres.",
      "maximum": 10000000,
      "minimum": 0,
      "title": "Maximum plot size (m2)",
      "type": "integer"
    },
    "maxPrice": {
      "description": "Maximum monthly cold rent or purchase price in EUR.",
      "maximum": 50000000,
      "minimum": 0,
      "title": "Maximum price (EUR)",
      "type": "integer"
    },
    "maxRooms": {
      "description": "Largest number of rooms to include.",
      "maximum": 50,
      "minimum": 0,
      "title": "Maximum rooms",
      "type": "number"
    },
    "maxYearBuilt": {
      "description": "Latest year the building was constructed.",
      "maximum": 2100,
      "minimum": 1800,
      "title": "Latest construction year",
      "type": "integer"
    },
    "minArea": {
      "description": "Minimum living space in square metres.",
      "maximum": 10000000,
      "minimum": 0,
      "title": "Minimum living space (m2)",
      "type": "integer"
    },
    "minBedrooms": {
      "description": "Smallest number of bedrooms to include.",
      "maximum": 20,
      "minimum": 0,
      "title": "Minimum bedrooms",
      "type": "integer"
    },
    "minPlotArea": {
      "description": "Minimum plot or land size in square metres.",
      "maximum": 10000000,
      "minimum": 0,
      "title": "Minimum plot size (m2)",
      "type": "integer"
    },
    "minPrice": {
      "description": "Minimum monthly cold rent or purchase price in EUR.",
      "maximum": 50000000,
      "minimum": 0,
      "title": "Minimum price (EUR)",
      "type": "integer"
    },
    "minRooms": {
      "description": "Smallest number of rooms to include.",
      "maximum": 50,
      "minimum": 0,
      "title": "Minimum rooms",
      "type": "number"
    },
    "minYearBuilt": {
      "description": "Earliest year the building was constructed.",
      "maximum": 2100,
      "minimum": 1800,
      "title": "Earliest construction year",
      "type": "integer"
    },
    "mode": {
      "default": "search",
      "description": "How to find listings: by German city and filters, by a pasted Immowelt search URL, or by listing IDs / expose URLs.",
      "editor": "select",
      "enum": [
        "search",
        "byUrl",
        "byIds"
      ],
      "enumTitles": [
        "Search by city and filters",
        "Use a pasted Immowelt search URL",
        "Look up specific listing IDs or URLs"
      ],
      "prefill": "search",
      "title": "Mode",
      "type": "string"
    },
    "projectTypes": {
      "default": [],
      "description": "Only include listings with one of the selected project or tenure types, such as new build, resale, investment or apartment swap.",
      "editor": "select",
      "items": {
        "enum": [
          "flatsharing",
          "investment",
          "life_annuity",
          "new_build",
          "projected",
          "resale",
          "short_time_rental",
          "stock",
          "swap_apartment"
        ],
        "enumTitles": [
          "Flatsharing / shared flat",
          "Investment property",
          "Life annuity",
          "New build",
          "Planned / under construction",
          "Resale",
          "Short-term rental",
          "Existing stock",
          "Apartment swap"
        ],
        "type": "string"
      },
      "prefill": [],
      "title": "Project / tenure types",
      "type": "array"
    },
    "propertyIds": {
      "default": [],
      "description": "Immowelt classified IDs or full /expose/... URLs. Both forms can be mixed.",
      "editor": "stringList",
      "prefill": [],
      "title": "Listing IDs or expose URLs (mode=byIds)",
      "type": "array"
    },
    "searchUrl": {
      "description": "A full Immowelt search-results URL, either a modern /classified-search URL or a /suche/... page. Any filters in the URL are respected.",
      "editor": "textfield",
      "title": "Search URL (mode=byUrl)",
      "type": "string"
    },
    "sellerType": {
      "default": "any",
      "description": "Filter by private owners, professional agents, or any seller.",
      "editor": "select",
      "enum": [
        "any",
        "private",
        "professional"
      ],
      "enumTitles": [
        "Any seller",
        "Private owner",
        "Professional agent"
      ],
      "prefill": "any",
      "title": "Seller type",
      "type": "string"
    },
    "sortBy": {
      "default": "",
      "description": "Order applied by Immowelt across the whole result set, not just one page.",
      "editor": "select",
      "enum": [
        "",
        "newest",
        "priceAsc",
        "priceDesc",
        "areaAsc",
        "areaDesc",
        "roomsAsc",
        "roomsDesc",
        "pricePerSqmAsc",
        "pricePerSqmDesc"
      ],
      "enumTitles": [
        "Relevance (site default)",
        "Newest listings first",
        "Price - low to high",
        "Price - high to low",
        "Living space / plot size - low to high",
        "Living space / plot size - high to low",
        "Rooms - fewest to most",
        "Rooms - most to fewest",
        "Price per m2 - low to high",
        "Price per m2 - high to low"
      ],
      "prefill": "",
      "title": "Sort results by",
      "type": "string"
    },
    "wbsRequired": {
      "default": false,
      "description": "Only include listings that require a certificate of eligibility (Wohnberechtigungsschein).",
      "prefill": false,
      "title": "WBS required (subsidised housing)",
      "type": "boolean"
    }
  },
  "required": [
    "mode"
  ],
  "schemaVersion": 1,
  "title": "Immowelt Scraper Input",
  "type": "object"
}
