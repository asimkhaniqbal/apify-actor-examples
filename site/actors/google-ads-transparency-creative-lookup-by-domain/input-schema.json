{
  "description": "Find ads by domain, brand, advertiser ID, or Transparency Center URL, with optional detail enrichment.",
  "properties": {
    "adFormat": {
      "default": "ALL",
      "description": "Restrict to one creative format.",
      "editor": "select",
      "enum": [
        "ALL",
        "TEXT",
        "IMAGE",
        "VIDEO",
        ""
      ],
      "enumTitles": [
        "All formats",
        "Text",
        "Image",
        "Video",
        "All formats (legacy)"
      ],
      "prefill": "ALL",
      "title": "Ad format",
      "type": "string"
    },
    "dateFrom": {
      "description": "Only ads shown on or after this date. Leave empty for no lower bound.",
      "editor": "textfield",
      "title": "Shown from (YYYY-MM-DD)",
      "type": "string"
    },
    "dateTo": {
      "description": "Only ads shown on or before this date. Leave empty for no upper bound.",
      "editor": "textfield",
      "title": "Shown to (YYYY-MM-DD)",
      "type": "string"
    },
    "includeDetails": {
      "default": true,
      "description": "Fetch every creative's variants, per-country run dates, EU impression ranges, targeting, advertiser identity, and any available ad copy. Adds one or two requests per ad.",
      "prefill": false,
      "title": "Include full ad details",
      "type": "boolean"
    },
    "maxItems": {
      "default": 100,
      "description": "Total records to return across all search terms.",
      "maximum": 100000,
      "minimum": 1,
      "prefill": 3,
      "title": "Max records",
      "type": "integer"
    },
    "maxItemsPerTerm": {
      "default": 0,
      "description": "Optional per-term cap. Set to 0 for no per-term cap.",
      "maximum": 100000,
      "minimum": 0,
      "prefill": 0,
      "title": "Max records per search term",
      "type": "integer"
    },
    "mode": {
      "default": "search",
      "description": "Search individual ads, or build one row per advertiser for a domain/brand (ad-check).",
      "editor": "select",
      "enum": [
        "search",
        "advertisers",
        "byQuery",
        "byAdvertiserId"
      ],
      "enumTitles": [
        "Search ads",
        "Ad-check: one row per advertiser",
        "Legacy: search by query",
        "Legacy: search by advertiser ID"
      ],
      "prefill": "search",
      "title": "Mode",
      "type": "string"
    },
    "platform": {
      "default": "ALL",
      "description": "Restrict to one Google surface. Platform filtering applies to ads shown from September 2023 onward.",
      "editor": "select",
      "enum": [
        "ALL",
        "SEARCH",
        "MAPS",
        "SHOPPING",
        "PLAY",
        "YOUTUBE",
