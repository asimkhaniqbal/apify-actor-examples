{
  "properties": {
    "fetchLenderQuotes": {
      "default": false,
      "description": "Enable Playwright pass to fetch individual lender quotes per state. Requires residential proxy and takes longer. Off by default.",
      "editor": "checkbox",
      "prefill": false,
      "title": "Fetch Lender Quotes",
      "type": "boolean"
    },
    "loanTypes": {
      "description": "Which loan types to scrape. All types are scraped if omitted.",
      "editor": "select",
      "items": {
        "enum": [
          "30yr-fixed",
          "15yr-fixed",
          "5/1-arm",
          "7/1-arm",
          "fha",
          "va",
          "jumbo"
        ],
        "enumTitles": [
          "30-Year Fixed",
          "15-Year Fixed",
          "5/1 ARM",
          "7/1 ARM",
          "FHA Loan",
          "VA Loan",
          "Jumbo Loan"
        ],
        "type": "string"
      },
      "prefill": [
        "30yr-fixed",
        "fha",
        "va"
      ],
      "title": "Loan Types",
      "type": "array"
    },
    "maxLendersPerState": {
      "default": 10,
      "description": "Maximum number of lender quotes to extract per state per loan type (1–50). Only applies when fetchLenderQuotes is enabled.",
      "editor": "number",
      "maximum": 50,
