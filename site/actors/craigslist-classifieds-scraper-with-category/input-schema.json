    },
    "hasImage": {
      "default": false,
      "description": "Only listings with at least one photo.",
      "prefill": false,
      "title": "Has image",
      "type": "boolean"
    },
    "hideDuplicates": {
      "default": false,
      "description": "Ask Craigslist to group duplicate/reposted listings together.",
      "prefill": false,
      "title": "Hide duplicate listings",
      "type": "boolean"
    },
    "includeDetails": {
      "default": true,
      "description": "Fetch each listing's full description, attributes, images, coordinates, and repost status. Turn off for faster search-card-only results.",
      "prefill": true,
      "title": "Include full listing details",
      "type": "boolean"
    },
    "maxAutoMiles": {
