    "countryCode": {
      "description": "Two-letter country code to filter the areas list (mode=areas), e.g. US, CA, GB. Leave blank for all 707 sites.",
      "editor": "textfield",
      "title": "Country code",
      "type": "string"
    },
    "cryptoOk": {
      "default": false,
      "description": "For-sale and auto categories: only listings that accept crypto.",
      "prefill": false,
      "title": "Cryptocurrency accepted",
      "type": "boolean"
    },
    "customRegion": {
      "description": "Any Craigslist hostname or abbreviation (e.g. humboldt, tokyo, sfbay). Overrides Region. (mode=search/category)",
      "editor": "textfield",
      "title": "Custom region",
      "type": "string"
    },
    "deliveryAvailable": {
      "default": false,
      "description": "For-sale and auto categories: only listings offering delivery.",
      "prefill": false,
      "title": "Delivery available",
