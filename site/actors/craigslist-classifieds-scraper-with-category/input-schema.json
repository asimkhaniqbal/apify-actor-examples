      "maximum": 10000,
      "minimum": 1,
      "prefill": 3,
      "title": "Maximum listings",
      "type": "integer"
    },
    "maxPrice": {
      "description": "Only listings at or below this price. Posts without a price are excluded when a price filter is set.",
      "editor": "number",
      "minimum": 0,
      "title": "Maximum price",
      "type": "integer"
    },
    "maxSqft": {
      "description": "Housing only.",
      "editor": "number",
      "maximum": 100000,
      "minimum": 0,
