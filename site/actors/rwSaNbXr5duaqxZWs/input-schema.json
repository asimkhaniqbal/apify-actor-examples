{
  "description": "Search the TikTok DSA ad library in 33 European markets and/or the global Creative Center Top Ads. No login, cookies or proxy setup needed.",
  "properties": {
    "adIds": {
      "default": [],
      "description": "Direct list of TikTok ad IDs. Skips search and opens each ad's detail page. (mode=library)",
      "editor": "stringList",
      "prefill": [],
      "title": "Ad IDs",
      "type": "array"
    },
    "adStatus": {
      "default": "active",
      "description": "Active ads are still being shown; inactive ads have stopped. (mode=library)",
