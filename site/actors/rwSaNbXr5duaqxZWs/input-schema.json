      "title": "Advertiser business ID",
      "type": "string"
    },
    "advertiserName": {
      "description": "Exact advertiser name as shown in the library, e.g. `NIKE Retail B.V.`. If the exact search finds nothing, the actor retries it as a keyword. (mode=library)",
