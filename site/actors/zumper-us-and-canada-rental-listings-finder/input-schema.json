{
  "description": "Search rental listings on Zumper by city and state, or fetch listing details.",
  "properties": {
    "bedrooms": {
      "description": "Number of bedrooms filter. 0 = studio.",
      "editor": "number",
      "maximum": 5,
      "minimum": 0,
      "title": "Bedrooms",
      "type": "integer"
    },
    "city": {
      "default": "San Francisco",
      "description": "City name (e.g. San Francisco, New York, Chicago). Used in searchRentals and searchByCity modes.",
      "editor": "textfield",
      "prefill": "San Francisco",
      "title": "City",
      "type": "string"
    },
    "listingUrls": {
      "default": [],
      "description": "List of Zumper listing URLs for detail scraping.",
      "editor": "stringList",
      "prefill": [],
      "title": "Listing URLs (mode=listingDetails)",
      "type": "array"
    },
    "maxItems": {
      "default": 20,
      "description": "Maximum number of listings to return.",
      "maximum": 1000,
      "minimum": 1,
      "prefill": 20,
      "title": "Max items",
      "type": "integer"
    },
    "mode": {
      "default": "searchRentals",
      "description": "What to scrape.",
      "editor": "select",
      "enum": [
        "searchRentals",
        "listingDetails",
        "searchByCity"
      ],
      "enumTitles": [
        "Search rentals by city & state",
        "Listing details by URL",
        "Search by city name (auto-format URL)"
      ],
      "prefill": "searchRentals",
      "title": "Mode",
      "type": "string"
    },
