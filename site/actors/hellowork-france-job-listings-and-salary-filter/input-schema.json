    "sortBy": {
      "default": "relevance",
      "description": "Result ordering.",
      "editor": "select",
      "enum": [
        "relevance",
        "date"
      ],
      "enumTitles": [
        "Relevance",
        "Newest first"
      ],
      "prefill": "relevance",
      "title": "Sort by",
      "type": "string"
    },
    "startUrls": {
      "default": [],
      "description": "HelloWork search-result URLs and/or job detail URLs. Mixed lists are allowed; duplicates are removed. Enter one URL per row in the Console (the request-list editor wraps it as `{\"url\": \"...\"}`); via the API, send `{\"url\": \"...\"}` objects.",
      "editor": "requestListSources",
      "items": {
        "properties": {
          "url": {
            "description": "HelloWork search-result or job detail URL.",
            "title": "URL",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "type": "object"
      },
      "prefill": [],
      "title": "Start URLs (mode=byUrls)",
      "type": "array"
    },
    "stateKey": {
      "default": "",
      "description": "Required when `incrementalMode` is on. Reuse the same key across scheduled runs.",
      "editor": "textfield",
      "prefill": "",
      "title": "Incremental state key",
      "type": "string"
    },
    "superRecruiterOnly": {
      "default": false,
