{
  "description": "Search HelloWork.com by keyword, browse by region/city or sector/function, or paste search and job URLs. Optional full-detail enrichment adds descriptions, skills, salary and exact dates.",
  "properties": {
    "city": {
      "default": "",
      "description": "French city or commune (e.g. `Lyon`, `Bordeaux`). Takes priority over `region`; also usable as a filter on other modes.",
      "editor": "textfield",
      "prefill": "",
      "title": "City (mode=byLocation)",
      "type": "string"
    },
    "companyTypes": {
      "default": [],
      "description": "Filter by the type of hiring organization (optional, all modes).",
      "editor": "select",
      "items": {
        "enum": [
          "Entreprises",
          "Cabinet_recr",
          "SSII",
          "Travail_temporaire",
          "Centre_formation"
        ],
        "enumTitles": [
          "Direct employer",
          "Recruitment agency",
          "IT services company (ESN)",
          "Temp staffing agency",
          "Training center"
        ],
        "type": "string"
      },
      "prefill": [],
      "title": "Company type",
      "type": "array",
      "uniqueItems": true
    },
    "contractTypes": {
      "default": [],
      "description": "Filter by one or more contract types (optional, all modes).",
      "editor": "select",
      "items": {
        "enum": [
          "CDI",
          "CDD",
          "Travail_temp",
          "Stage",
          "Alternance",
          "Independant",
          "Franchise",
          "Associe",
          "Fonctionnaire",
          "Freelance",
          "Stage_de_lycee"
        ],
        "enumTitles": [
          "CDI (permanent contract)",
          "CDD (fixed-term contract)",
          "Intérim (temp work)",
          "Stage (internship)",
          "Alternance (apprenticeship)",
          "Indépendant (self-employed)",
          "Franchise",
          "Associé (partner)",
          "Fonctionnaire (civil servant)",
          "Freelance",
          "Stage de lycée (high-school internship)"
        ],
        "type": "string"
      },
      "prefill": [],
      "title": "Contract type",
      "type": "array",
      "uniqueItems": true
    },
    "csrLabels": {
      "default": [],
      "description": "Filter to employers holding a specific CSR (corporate social responsibility) certification (optional, all modes).",
      "editor": "select",
      "items": {
        "enum": [
          "_10556393",
          "_b64a8fe7",
          "_9ffe5c83",
          "_3a9a1663",
          "_a2f6a46f",
          "_2d67f571",
          "_79347e6b",
          "_e7ce5995",
          "_7b05b6d4",
          "d5bab309073b"
        ],
        "enumTitles": [
          "B Corp",
          "Ecocert 26000",
          "EcoVadis",
          "Engagé RSE",
          "For Life",
          "Lucie 26000",
          "PME+",
          "Positive Company",
          "Responsible Care",
          "Safe Place"
        ],
        "type": "string"
      },
      "prefill": [],
      "title": "CSR / sustainability label",
      "type": "array",
      "uniqueItems": true
    },
    "employmentType": {
      "default": [],
      "description": "Filter by employment schedule -- full-time vs part-time (optional, all modes).",
      "editor": "select",
      "items": {
        "enum": [
          "ft",
          "pt",
          "np"
        ],
        "enumTitles": [
          "Temps plein (full-time)",
          "Temps partiel (part-time)",
          "Non précisé (unspecified)"
        ],
        "type": "string"
      },
      "prefill": [],
      "title": "Employment time (temps de travail)",
      "type": "array",
      "uniqueItems": true
    },
    "exactMatchesOnly": {
      "default": false,
      "description": "Drop HelloWork similar-result cards (\"LO-Moteur-Approchant\"). Useful for narrow technical queries.",
      "prefill": false,
      "title": "Only exact keyword matches",
      "type": "boolean"
    },
    "experienceLevels": {
      "default": [],
      "description": "Filter by the years of experience the employer asks for (optional, all modes).",
      "editor": "select",
      "items": {
        "enum": [
          "deb",
          "0-1y",
          "2-3y",
          "4-5y",
          "6-10y",
          "gt10y",
          "unknown"
        ],
        "enumTitles": [
          "Débutants acceptés (débutant / no experience required)",
          "0-1 year (débutants accepted)",
          "2-3 years",
          "4-5 years",
          "6-10 years",
          "10+ years",
          "Not specified"
        ],
        "type": "string"
      },
      "prefill": [],
      "title": "Experience level required",
      "type": "array",
      "uniqueItems": true
    },
    "includeCompanyProfile": {
      "default": false,
      "description": "Add headquarters, founding year, employee range, revenue and telework policy when the employer page exposes them. Requires includeDetails. Adds one request per unique company.",
      "prefill": false,
      "title": "Include company profile",
      "type": "boolean"
    },
    "includeDetails": {
      "default": true,
      "description": "Open each job page for description, skills, structured salary, exact dates and location. Adds one request per job.",
      "prefill": false,
      "title": "Fetch full job details",
      "type": "boolean"
    },
    "incrementalMode": {
      "default": false,
      "description": "Keep state per `stateKey` and emit only new, updated or reappeared jobs. Unchanged jobs are updated in state and skipped.",
      "prefill": false,
      "title": "Incremental runs (only new or changed jobs)",
      "type": "boolean"
    },
    "jobFunctions": {
      "default": [],
