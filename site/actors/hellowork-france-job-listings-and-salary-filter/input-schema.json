    "remoteWork": {
      "default": [],
      "description": "Filter by disclosed remote-work (télétravail) frequency (optional, all modes).",
      "editor": "select",
      "items": {
        "enum": [
          "Complet",
          "Partiel",
          "Occasionnel",
          "Pas_teletravail"
        ],
        "enumTitles": [
          "Télétravail complet (fully remote)",
          "Télétravail partiel (hybrid remote)",
          "Télétravail occasionnel (occasional remote)",
          "Pas de télétravail (no remote work)"
        ],
        "type": "string"
      },
      "prefill": [],
      "title": "Remote work (télétravail)",
      "type": "array",
      "uniqueItems": true
    },
    "salaryOnly": {
      "default": false,
      "description": "Only include job listings that disclose a salary range (optional, all modes).",
      "prefill": false,
      "title": "Only offers with disclosed salary",
      "type": "boolean"
    },
    "searchQueries": {
      "default": [],
      "description": "One or more free-text keyword searches (mode=search). Each query runs with the same filters; duplicate jobs are removed.",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "prefill": [
        "developpeur"
      ],
      "title": "Search queries",
      "type": "array"
    },
