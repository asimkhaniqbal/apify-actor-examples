      "prefill": [],
      "title": "Job functions / métiers",
      "type": "array",
      "uniqueItems": true
    },
    "maxItems": {
      "default": 50,
      "description": "Hard cap on emitted job listings (1–10,000).",
      "maximum": 10000,
      "minimum": 1,
      "prefill": 3,
      "title": "Max items",
      "type": "integer"
    },
    "minSalary": {
      "default": 0,
      "description": "Only include jobs whose disclosed salary meets this yearly gross EUR floor (optional, all modes). Matches HelloWork's own \"Salaire minimum\" slider (0-100,000, steps of 1,000).",
      "maximum": 100000,
      "minimum": 0,
      "prefill": 0,
      "title": "Minimum annual salary (EUR)",
      "type": "integer"
    },
    "mode": {
      "default": "search",
      "description": "What to fetch.",
      "editor": "select",
      "enum": [
        "search",
        "byLocation",
        "bySector",
        "byUrls"
      ],
      "enumTitles": [
        "Search jobs by keyword",
        "Browse jobs by region / city",
        "Browse jobs by sector / function",
        "Scrape pasted HelloWork URLs"
      ],
      "prefill": "search",
      "title": "Mode",
      "type": "string"
    },
    "postedWithin": {
      "default": "all",
      "description": "Only include jobs posted within this time window (optional, all modes).",
      "editor": "select",
      "enum": [
        "all",
        "h",
        "d",
        "w",
        "m"
      ],
      "enumTitles": [
        "Any time (no filter)",
        "Last 24 hours",
        "Last 3 days",
        "Last week",
        "Last month"
      ],
      "prefill": "all",
      "title": "Posted within",
      "type": "string"
    },
    "radiusKm": {
      "default": "20",
      "description": "Widen or narrow the search radius around `city` (ignored when only `region` is set -- HelloWork's radius filter only applies to a specific city/commune).",
      "editor": "select",
      "enum": [
        "0",
        "5",
        "10",
        "20",
        "50"
      ],
      "enumTitles": [
        "0 km (exact city only)",
        "5 km",
        "10 km",
        "20 km (default)",
        "50 km"
      ],
      "prefill": "20",
      "title": "Search radius in km (mode=byLocation with city)",
      "type": "string"
    },
    "region": {
      "default": "",
      "description": "French administrative region. Required for mode=byLocation unless `city` is set; also usable as a filter on other modes.",
      "editor": "select",
      "enum": [
