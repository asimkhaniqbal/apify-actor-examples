    "hasWebsite": {
      "default": false,
      "description": "Drop listings where no website could be found.",
      "prefill": false,
      "title": "Only listings with a website",
      "type": "boolean"
    },
    "includeCompanyRegistry": {
      "default": false,
      "description": "For businesses with a kennitala, also read the public Skatturinn company registry: legal name, registration date, legal form, municipality, ISAT industry, VAT number, board members, and annual-accounts filing history. Adds one request per business.",
      "prefill": false,
      "title": "Add Icelandic company-registry data",
      "type": "boolean"
    },
    "maxItems": {
      "default": 30,
      "description": "Hard cap on emitted records. Ja.is results are paginated to the end of the source's result set (up to 10,000). Very broad city-only queries page through people too, so add a category or keyword for large exports.",
      "maximum": 10000,
      "minimum": 1,
      "prefill": 3,
      "title": "Max items",
      "type": "integer"
    },
    "mode": {
      "default": "search",
      "description": "What to fetch.",
      "editor": "select",
      "enum": [
        "search",
        "byCategory",
        "byCity",
        "byUrl"
      ],
      "enumTitles": [
        "Search by name / keyword",
        "Browse by business category",
        "Browse by city / town",
        "Fetch specific Ja.is URLs"
      ],
      "prefill": "search",
      "title": "Mode",
      "type": "string"
    },
    "openNow": {
      "default": false,
      "description": "Keep only businesses whose published opening hours say they are open at scrape time. Listings without opening hours are dropped.",
      "prefill": false,
      "title": "Only listings open now",
      "type": "boolean"
    },
    "postalCode": {
      "description": "Optional three-digit Icelandic postal code (for example `101`). Combine with a city or category for a precise area export.",
      "editor": "textfield",
      "pattern": "^[0-9]{3}$",
      "title": "Postal code",
      "type": "string"
    },
    "searchQueries": {
      "description": "One or more free-text searches. Each query matches names, addresses, occupations, and trade words. Icelandic characters are supported. A saved task that still sends `searchQuery` keeps working.",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "prefill": [
        "bakarí"
      ],
      "title": "Search queries (mode=search)",
      "type": "array"
    },
    "searchScope": {
      "default": "all",
      "description": "Which listing types to include.",
      "editor": "select",
      "enum": [
        "all",
        "people",
        "businesses"
      ],
      "enumTitles": [
        "People + businesses",
        "People (white pages) only",
        "Businesses (yellow pages) only"
      ],
      "prefill": "all",
      "title": "Result type",
      "type": "string"
    },
    "urls": {
      "default": [],
      "description": "Business, person, or Ja.is search URLs. Examples: `https://ja.is/myllan-bakari/`, `https://ja.is/e/eZZdk/`, `https://ja.is/?q=bakar%C3%AD`.",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "prefill": [],
      "title": "Ja.is URLs (mode=byUrl)",
      "type": "array"
    }
