    "maxItems": {
      "default": 20,
      "description": "Hard cap on emitted license records.",
      "maximum": 5000,
      "minimum": 1,
      "prefill": 20,
      "title": "Max items",
      "type": "integer"
    },
    "mode": {
      "default": "byName",
      "description": "How to look up licenses. The three name modes return the same record shape; they only change which name column the search matches.",
      "editor": "select",
      "enum": [
        "byName",
        "byOwnerName",
        "byBusinessName",
        "byLicenseNumber"
      ],
      "enumTitles": [
        "Search owner or business name",
        "Search owner name only",
        "Search business name only",
        "Look up by license number"
      ],
      "prefill": "byName",
      "title": "Mode",
      "type": "string"
    },
    "nameQuery": {
      "default": "Smith",
      "description": "Case-insensitive partial match against the license holder name in `byOwnerName`, the business/DBA name in `byBusinessName`, or either in `byName` (e.g. `Smith` or `Star Electrical`). Optional if `licenseType`, `countyFilter`, `cityFilter` or `zipFilter` is set — leaving it blank then browses all licenses matching those filters.",
      "editor": "textfield",
      "prefill": "Smith",
      "title": "Name to search (name modes)",
      "type": "string"
    },
    "sortBy": {
      "default": "licenseNumber",
      "description": "Order results are fetched/emitted in. Defaults to license number.",
      "editor": "select",
      "enum": [
        "licenseNumber",
        "ownerName",
        "businessName",
        "expirationDate"
      ],
      "enumTitles": [
        "License number",
        "Owner name",
        "Business name",
        "Expiration date"
      ],
      "prefill": "licenseNumber",
      "title": "Sort order",
      "type": "string"
    },
    "sortDirection": {
      "default": "asc",
      "description": "Ascending or descending for the selected sort field. Expiration sorting is chronological, not month-first text order.",
      "editor": "select",
      "enum": [
        "asc",
        "desc"
      ],
      "enumTitles": [
        "Ascending (A→Z, oldest→newest)",
        "Descending (Z→A, newest→oldest)"
      ],
      "prefill": "asc",
      "title": "Sort direction",
      "type": "string"
    },
    "statusFilter": {
      "default": "",
      "description": "Only emit licenses that are currently active or expired, based on the license expiration date. Leave unset for both.",
      "editor": "select",
      "enum": [
        "",
        "active",
        "expired"
      ],
      "enumTitles": [
        "All statuses",
        "Active",
        "Expired"
      ],
      "prefill": "",
      "title": "Filter by license status",
      "type": "string"
    },
    "zipFilter": {
      "description": "Only emit licenses whose business or mailing ZIP starts with this 5-digit code, e.g. `78701`. ZIP+4 input is accepted and truncated to the 5-digit prefix.",
      "editor": "textfield",
      "title": "Filter by ZIP code",
      "type": "string"
    }
  },
  "required": [
    "mode"
  ],
  "schemaVersion": 1,
  "title": "TDLR Texas License Scraper Input",
  "type": "object"
}
