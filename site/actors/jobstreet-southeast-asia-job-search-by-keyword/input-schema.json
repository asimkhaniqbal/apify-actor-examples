      "title": "Classification",
      "type": "string"
    },
    "compact": {
      "default": false,
      "description": "Keep only core job fields (identity, company, salary, dates, URL) for lightweight feeds.",
      "prefill": false,
      "title": "Compact output",
      "type": "boolean"
    },
    "companies": {
      "description": "Company URLs, profile or organisation ids, or names, one per line (mode=companyJobs / companyProfiles). Several companies are interleaved so maxItems covers each one.",
      "editor": "textarea",
      "title": "Companies",
      "type": "string"
    },
    "country": {
      "default": "sg",
      "description": "Market to search. Covers JobStreet Malaysia, Singapore, Indonesia and the Philippines, plus JobsDB Thailand and Hong Kong.",
      "editor": "select",
      "enum": [
        "my",
        "sg",
        "id",
        "ph",
        "th",
        "hk"
      ],
      "enumTitles": [
        "Malaysia (JobStreet)",
        "Singapore (JobStreet)",
        "Indonesia (JobStreet)",
        "Philippines (JobStreet)",
        "Thailand (JobsDB)",
        "Hong Kong (JobsDB)"
      ],
      "prefill": "sg",
      "title": "Country",
      "type": "string"
    },
    "dateRange": {
      "description": "Only jobs listed in the last N days (mode=searchJobs).",
      "editor": "select",
      "enum": [
        "1",
        "3",
        "7",
        "14",
        "31"
      ],
      "enumTitles": [
        "Last 24 hours",
        "Last 3 days",
        "Last 7 days",
        "Last 14 days",
        "Last 30 days"
      ],
      "title": "Listed within",
      "type": "string"
    },
    "descriptionFormat": {
      "default": "text",
      "description": "How job descriptions are returned.",
      "editor": "select",
      "enum": [
        "text",
        "html",
        "both"
      ],
      "enumTitles": [
        "Plain text",
        "HTML",
        "Both"
      ],
      "prefill": "text",
      "title": "Description format",
      "type": "string"
    },
    "emitExpired": {
      "default": false,
      "description": "When incremental mode is on, emit jobs that were seen before but have disappeared.",
      "prefill": false,
      "title": "Emit expired jobs",
      "type": "boolean"
    },
    "emitUnchanged": {
      "default": false,
      "description": "When incremental mode is on, also emit jobs whose content has not changed.",
      "prefill": false,
      "title": "Emit unchanged jobs",
      "type": "boolean"
    },
    "excludeKeywords": {
      "description": "Drop jobs whose title, company or description contains any term, one per line.",
      "editor": "textarea",
      "title": "Exclude keywords",
      "type": "string"
    },
    "includeApplicantInsights": {
      "default": true,
      "description": "Add applicant count, application volume and resume / cover-letter percentages when the source exposes them.",
      "prefill": true,
      "title": "Include applicant insights",
      "type": "boolean"
    },
    "includeCompanyProfile": {
      "default": true,
      "description": "Add company rating, industry, size, website and description to each job when available.",
      "prefill": true,
      "title": "Include company snapshot",
      "type": "boolean"
    },
    "includeCompanySalaries": {
      "default": false,
      "description": "Fetch salary ranges by role for each company.",
      "prefill": false,
      "title": "Include company salary ranges",
      "type": "boolean"
    },
    "includeDetails": {
      "default": true,
      "description": "Fetch the full description, salary, applicant demand and company snapshot for each job (job modes).",
      "prefill": true,
      "sectionCaption": "Job details",
      "title": "Include full job details",
      "type": "boolean"
    },
    "includeKeywords": {
      "description": "Keep only jobs whose title, company or description contains at least one term, one per line (case-insensitive).",
      "editor": "textarea",
      "sectionCaption": "Client-side filters",
      "title": "Must include keywords",
      "type": "string"
    },
    "includeOpenJobs": {
      "default": true,
      "description": "Attach the company's current open jobs (mode=companyProfiles).",
      "prefill": true,
      "title": "Include open jobs",
      "type": "boolean"
    },
    "includeRegionalSalaries": {
      "default": false,
      "description": "Add state / city salary breakdowns for each role.",
      "prefill": false,
      "title": "Include regional salaries",
      "type": "boolean"
    },
    "includeReviews": {
      "default": false,
      "description": "Fetch employee reviews for each company (mode=companyProfiles, or company URLs in byUrls).",
      "prefill": false,
      "title": "Include company reviews",
      "type": "boolean"
    },
    "includeRoleDetails": {
      "default": false,
      "description": "Add role summary, tasks, skills, growth, review statistics and similar roles.",
      "prefill": false,
      "title": "Include role details",
      "type": "boolean"
    },
    "incrementalMode": {
      "default": false,
      "description": "Emit only new or changed jobs, using saved state between runs (job modes).",
      "prefill": false,
      "title": "Incremental mode",
      "type": "boolean"
    },
    "keywords": {
      "description": "One job title or keyword per line (mode=searchJobs). Each keyword is searched separately and results are deduplicated.",
      "editor": "textarea",
      "sectionCaption": "Search",
      "title": "Keywords",
      "type": "string"
    },
    "language": {
      "default": "en",
      "description": "Interface language. Only English is available in every market; other options are used where the market supports them.",
      "editor": "select",
      "enum": [
        "en",
        "id",
        "th",
        "zh"
      ],
      "enumTitles": [
        "English",
        "Bahasa Indonesia",
        "Thai",
        "Traditional Chinese"
      ],
      "prefill": "en",
      "title": "Language",
      "type": "string"
    },
    "listedAfter": {
      "description": "Drop jobs listed before this date (YYYY-MM-DD).",
      "editor": "textfield",
      "title": "Listed after",
      "type": "string"
    },
    "listedBefore": {
      "description": "Drop jobs listed after this date (YYYY-MM-DD).",
      "editor": "textfield",
      "title": "Listed before",
      "type": "string"
    },
    "locations": {
      "description": "Optional cities or regions, one per line; combined with each keyword (mode=searchJobs).",
      "editor": "textarea",
      "title": "Locations",
      "type": "string"
    },
    "maxApplicants": {
      "description": "Drop jobs with more applicants than this. Requires job details.",
      "maximum": 10000000,
      "minimum": 0,
      "title": "Maximum applicants",
      "type": "integer"
    },
    "maxItems": {
      "default": 50,
      "description": "Hard cap on records returned. Applies across all keywords, locations and pages.",
      "maximum": 5000,
      "minimum": 1,
      "prefill": 3,
      "sectionCaption": "Limits and incremental runs",
      "title": "Max items",
      "type": "integer"
    },
    "maxOpenJobs": {
      "default": 20,
      "description": "Cap on attached open jobs per company.",
      "maximum": 100,
      "minimum": 1,
      "prefill": 20,
      "title": "Max open jobs per company",
      "type": "integer"
    },
    "maxPages": {
      "default": 10,
      "description": "Page cap for each keyword/location (100 jobs per page).",
      "maximum": 100,
      "minimum": 1,
      "prefill": 1,
      "title": "Max pages per query",
      "type": "integer"
    },
    "maxReviewsPerCompany": {
      "default": 10,
      "description": "Review cap per company.",
      "maximum": 100,
      "minimum": 1,
      "prefill": 10,
      "title": "Max reviews per company",
      "type": "integer"
    },
    "minApplicants": {
      "description": "Drop jobs with fewer applicants than this. Requires job details.",
      "maximum": 10000000,
      "minimum": 0,
      "title": "Minimum applicants",
      "type": "integer"
    },
    "mode": {
      "default": "searchJobs",
      "description": "What to fetch from JobStreet / JobsDB.",
      "editor": "select",
      "enum": [
        "searchJobs",
        "byUrls",
        "companyJobs",
        "companyProfiles",
        "salaryBenchmarks"
      ],
      "enumTitles": [
        "Search jobs by keyword and filters",
        "Scrape specific job, search or company URLs",
        "Open jobs from companies",
        "Company profiles, reviews and salary ranges",
        "Role salary benchmarks"
      ],
      "prefill": "searchJobs",
      "title": "Mode",
      "type": "string"
    },
    "roles": {
      "description": "Role titles or queries to benchmark, one per line (mode=salaryBenchmarks).",
      "editor": "textarea",
      "sectionCaption": "Salary benchmarks",
      "title": "Role titles",
      "type": "string"
    },
    "salaryMax": {
      "description": "Drop jobs whose advertised salary is entirely above this amount, in the unit chosen by Salary type.",
      "maximum": 100000000,
      "minimum": 0,
      "title": "Salary maximum",
      "type": "integer"
    },
    "salaryMin": {
      "description": "Drop jobs whose advertised salary is entirely below this amount, in the unit chosen by Salary type. Jobs with no salary are dropped when this is set.",
      "maximum": 100000000,
      "minimum": 0,
      "title": "Salary minimum",
      "type": "integer"
    },
    "salaryType": {
      "default": "monthly",
      "description": "Unit for the salary minimum / maximum filters.",
      "editor": "select",
      "enum": [
        "monthly",
        "annual",
        "hourly"
      ],
      "enumTitles": [
        "Monthly",
        "Annual",
        "Hourly"
      ],
      "prefill": "monthly",
      "title": "Salary type",
      "type": "string"
    },
    "sortBy": {
      "default": "relevance",
      "description": "Result order (mode=searchJobs).",
      "editor": "select",
      "enum": [
        "relevance",
        "date"
      ],
      "enumTitles": [
        "Relevance",
        "Newest first"
      ],
      "prefill": "relevance",
      "title": "Sort by",
      "type": "string"
    },
    "startUrls": {
      "description": "Job, search or company URLs, one per line (mode=byUrls). Each URL's own market is used; a search URL keeps its page number.",
      "editor": "textarea",
      "sectionCaption": "URLs and companies",
      "title": "Start URLs",
      "type": "string"
    },
    "stateKey": {
      "description": "Name for the saved incremental state. Use the same key on each scheduled run.",
      "editor": "textfield",
      "title": "State key",
      "type": "string"
    },
