    "languageCode": {
      "default": "en",
      "description": "Language for results (hl parameter). E.g. 'en', 'de', 'fr'. Leave empty for default.",
      "editor": "textfield",
      "title": "Language",
      "type": "string"
    },
    "maxPrice": {
      "description": "Maximum price filter (in local currency units). Leave empty for no maximum.",
      "minimum": 0,
      "title": "Maximum Price",
      "type": "integer"
    },
    "maxResultsPerQuery": {
      "default": 20,
      "description": "Maximum number of product results to extract per search query.",
      "maximum": 100,
      "minimum": 1,
      "prefill": 5,
      "title": "Max Results Per Query",
      "type": "integer"
    },
    "minPrice": {
      "description": "Minimum price filter (in local currency units). Leave empty for no minimum.",
      "minimum": 0,
      "title": "Minimum Price",
      "type": "integer"
    },
    "proxyConfiguration": {
      "default": {
        "apifyProxyGroups": [
          "GOOGLE_SERP"
        ],
        "useApifyProxy": true
      },
      "description": "Proxy configuration. GOOGLE_SERP proxy provides the most reliable access to Google Shopping.",
      "editor": "proxy",
      "title": "Proxy Configuration",
      "type": "object"
    },
    "queries": {
      "description": "List of product search queries to look up on Google Shopping (e.g., \"iPhone 15 Pro Max\", \"running shoes\").",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "prefill": [
        "iPhone 15 Pro Max"
      ],
      "title": "Search Queries",
      "type": "array"
    },
    "sortBy": {
      "default": "",
      "description": "How to sort Google Shopping results.",
      "editor": "select",
      "enum": [
        "",
        "review_score",
        "price_low",
        "price_high"
      ],
      "enumTitles": [
        "Relevance (default)",
        "Review score",
        "Price: low to high",
        "Price: high to low"
      ],
      "title": "Sort By",
      "type": "string"
    }
  },
  "required": [
    "queries"
  ],
  "schemaVersion": 1,
  "title": "Google Shopping Insights Scraper Input",
  "type": "object"
