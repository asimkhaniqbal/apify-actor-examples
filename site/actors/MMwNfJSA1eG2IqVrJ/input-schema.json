{
  "description": "Search Google Shopping for products and extract prices, merchants, ratings, and more.",
  "properties": {
    "condition": {
      "default": "",
      "description": "Filter products by condition.",
      "editor": "select",
      "enum": [
        "",
        "new",
        "used",
        "refurbished"
      ],
      "enumTitles": [
        "Any",
        "New",
        "Used",
        "Refurbished"
      ],
      "title": "Condition",
      "type": "string"
    },
