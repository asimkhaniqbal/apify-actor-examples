        "Internship",
        "Volunteer",
        "Other"
      ],
      "prefill": "",
      "title": "Employment type",
      "type": "string"
    },
    "excludeWorldwide": {
      "default": false,
      "description": "When a country is set, exclude jobs that are open worldwide. Requires country.",
      "prefill": false,
      "title": "Exclude worldwide",
      "type": "boolean"
    },
    "includeCompanyTechStack": {
      "default": false,
      "description": "Fetch the employer's company-level tech stack once per company. Many companies do not publish one, so this field is often absent. Shares the same anonymous lookup limit.",
      "prefill": false,
      "title": "Include company tech stack",
      "type": "boolean"
    },
    "includeSkills": {
      "default": false,
      "description": "Fetch each job's required skills from Himalayas job details. Adds one lookup per job; the public anonymous limit is 30 lookups per minute and 200 per day, so large runs keep base records and stop enrichment at the limit.",
      "prefill": false,
      "title": "Include job skills",
      "type": "boolean"
    },
    "jobUrls": {
      "default": [],
      "description": "Himalayas job page URLs, e.g. `https://himalayas.app/companies/stripe/jobs/senior-engineer`. Closed or invalid URLs are skipped.",
      "editor": "stringList",
      "prefill": [],
      "title": "Job URLs (mode=byJobUrls)",
      "type": "array"
    },
    "maxItems": {
      "default": 20,
      "description": "Hard cap on the number of job records emitted (1–5000).",
      "maximum": 5000,
      "minimum": 1,
      "prefill": 3,
      "title": "Max items",
      "type": "integer"
    },
    "maxSalary": {
      "description": "Annualised salary ceiling. Jobs whose annualised range starts above this value are excluded.",
      "maximum": 10000000,
      "minimum": 0,
      "title": "Maximum salary (annualised)",
      "type": "integer"
    },
    "minSalary": {
      "description": "Annualised salary floor. Hourly, weekly and monthly pay is converted to a yearly figure before comparison. Use salaryCurrency to compare in a specific currency.",
      "maximum": 10000000,
      "minimum": 0,
      "title": "Minimum salary (annualised)",
      "type": "integer"
    },
    "mode": {
      "default": "searchJobs",
      "description": "What to scrape. `searchJobs` runs a keyword search with filters. `browseAll` walks the newest-updated feed. `byCompany` returns a company's open roles. `byJobUrls` checks specific job URLs.",
      "editor": "select",
      "enum": [
        "searchJobs",
        "browseAll",
        "byCompany",
        "byJobUrls"
      ],
      "enumTitles": [
        "Search jobs (keyword + filters)",
        "Browse newest jobs (full feed)",
        "All jobs for company slug(s)",
        "Resolve specific job URLs"
      ],
      "prefill": "searchJobs",
      "title": "Mode",
      "type": "string"
    },
