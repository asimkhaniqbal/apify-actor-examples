    "employmentType": {
      "default": "",
      "description": "Keep jobs of this employment type. Leave blank for all types.",
      "editor": "select",
      "enum": [
        "",
        "full-time",
        "part-time",
        "contract",
        "temporary",
        "internship",
        "volunteer",
        "other"
      ],
