      "description": "Free-text keyword search (mode=searchJobs). Leave blank to page through the newest searchable listings. Himalayas caps keyword searches at 5,000 results.",
      "editor": "textfield",
      "prefill": "software engineer",
      "title": "Search query",
      "type": "string"
    },
    "seniority": {
      "default": [],
      "description": "Keep jobs at any of these seniority levels. Leave empty for all levels.",
      "editor": "stringList",
      "prefill": [],
      "title": "Seniority",
      "type": "array"
    },
    "sortBy": {
      "default": "recent",
      "description": "Search result order. Browse mode always uses newest-updated order.",
      "editor": "select",
      "enum": [
        "relevant",
        "recent",
        "salaryAsc",
        "salaryDesc",
        "nameAToZ",
        "nameZToA",
        "jobs"
      ],
      "enumTitles": [
        "Relevance",
        "Most recent",
        "Salary low to high",
        "Salary high to low",
        "Company A to Z",
        "Company Z to A",
        "Number of open roles"
      ],
      "prefill": "recent",
      "title": "Sort order",
      "type": "string"
    },
    "timezone": {
      "description": "Keep jobs that accept this UTC offset, e.g. `-5`, `UTC-5` or `UTC+05:30`. Leave blank for any timezone.",
      "editor": "textfield",
      "title": "Timezone offset",
      "type": "string"
    },
    "worldwide": {
      "default": false,
      "description": "Only jobs with no country restrictions. Overrides the country filter.",
      "prefill": false,
      "title": "Worldwide only",
      "type": "boolean"
    }
