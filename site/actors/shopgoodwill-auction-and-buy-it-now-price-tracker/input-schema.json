      "title": "Include closed/ended auctions",
      "type": "boolean"
    },
    "includeDetails": {
      "default": false,
      "description": "For search/category/seller modes, fetch each item's detail page too (one extra request per item). Adds full description, all images, seller name/address, pickup details, reserve info and bid history. Slower and heavier.",
      "prefill": false,
      "sectionCaption": "Advanced",
      "title": "Enrich listing modes with item details",
      "type": "boolean"
    },
    "itemIds": {
      "default": [],
      "description": "ShopGoodwill item IDs or full item URLs, e.g. `269254306` or `https://shopgoodwill.com/item/269254306`. Duplicates and invalid entries are ignored.",
      "editor": "stringList",
      "prefill": [],
      "title": "Item IDs or item URLs (mode=byItemIds)",
      "type": "array"
    },
    "maxItems": {
      "default": 40,
      "description": "Hard cap on emitted records.",
      "maximum": 2000,
      "minimum": 1,
      "prefill": 3,
      "title": "Max items",
      "type": "integer"
    },
    "mode": {
      "default": "search",
      "description": "What to fetch. `search` finds live or recently sold listings by keyword; `byCategory` browses one category; `bySeller` browses one Goodwill store; `byItemIds` fetches full detail for specific item IDs or item URLs.",
      "editor": "select",
      "enum": [
        "search",
        "byCategory",
        "bySeller",
        "byItemIds"
      ],
      "enumTitles": [
        "Keyword search",
        "Browse by category",
        "Browse by seller (Goodwill store)",
        "Look up item IDs or item URLs"
      ],
      "prefill": "search",
      "sectionCaption": "What to scrape",
      "sectionDescription": "Pick one source of listings. Keyword search is the daily-test default.",
      "title": "Mode",
      "type": "string"
    },
    "oneCentShippingOnly": {
      "default": false,
      "description": "Only include items whose seller offers $0.01 shipping.",
      "prefill": false,
      "title": "One-cent shipping only",
      "type": "boolean"
    },
    "pickupOnly": {
      "default": false,
      "description": "Only include items offered for local pickup (skip shipped-only listings).",
      "prefill": false,
      "title": "Local pickup listings only",
      "type": "boolean"
    },
    "priceMax": {
      "description": "Drop items priced above this (current bid or buy-now price).",
      "maximum": 999999,
      "minimum": 0,
      "title": "Max price (USD)",
      "type": "integer"
    },
    "priceMin": {
      "description": "Drop items priced below this (current bid or buy-now price).",
      "maximum": 999999,
      "minimum": 0,
      "sectionCaption": "Filters & sorting",
      "title": "Min price (USD)",
      "type": "integer"
    },
    "searchDescriptions": {
      "default": false,
      "description": "Match the query against item descriptions in addition to titles.",
      "prefill": false,
      "title": "Search item descriptions too",
      "type": "boolean"
    },
    "searchQuery": {
      "default": "",
      "description": "Free-text keyword search (mode=search). Combine with `brand` / `sizeKeyword` — ShopGoodwill has no separate brand or size facet, so these terms are ANDed into the search text.",
      "editor": "textfield",
      "prefill": "nike",
      "title": "Search query",
      "type": "string"
    },
    "sellerId": {
      "description": "Numeric ShopGoodwill seller/store ID, e.g. `16` (Goodwill Industries of South Florida). Found in an item's `sellerId` output field.",
      "maximum": 999999,
      "minimum": 1,
      "title": "Seller ID (mode=bySeller)",
      "type": "integer"
    },
    "shippingDestination": {
      "default": "any",
      "description": "Keep only items whose seller ships to this destination: anywhere, US only, Canada, or international.",
      "editor": "select",
      "enum": [
        "any",
        "usOnly",
        "canada",
        "international"
      ],
      "enumTitles": [
        "Any destination",
        "US only",
        "Canada",
        "International"
      ],
      "prefill": "any",
      "title": "Ships to",
      "type": "string"
    },
    "sizeKeyword": {
      "description": "Optional size ANDed into the search text (e.g. `medium`, `size 8`, `xl`). Keyword narrowing, not an exact facet.",
      "editor": "textfield",
      "title": "Size keyword",
      "type": "string"
    },
    "sortBy": {
      "default": "endingSoonest",
      "description": "Result ordering.",
      "editor": "select",
      "enum": [
        "endingSoonest",
        "endingLatest",
