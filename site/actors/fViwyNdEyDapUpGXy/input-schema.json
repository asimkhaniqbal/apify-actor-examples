{
  "description": "Scrape AliExpress search results, products, stores and reviews across all major regional storefronts.",
  "properties": {
    "autoEscalateOnBlock": {
      "default": true,
      "description": "If a request is blocked or rate-limited, transparently switch to Apify residential proxy for retries.",
      "editor": "checkbox",
      "prefill": true,
      "title": "Auto-escalate on block",
      "type": "boolean"
    },
    "currency": {
      "default": "USD",
      "description": "ISO-4217 currency code. Sent via the aep_usuc_f locale cookie; AliExpress may override it with the proxy IP's local currency. Output currencyCode reflects the actual currency returned by AliExpress. For deterministic currency, pair with useProxy and a residential proxy in the target country.",
      "editor": "select",
      "enum": [
        "USD",
        "EUR",
        "GBP",
        "JPY",
        "CNY",
        "RUB",
        "BRL",
        "INR",
        "AUD",
