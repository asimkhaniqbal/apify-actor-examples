        "VND",
        "PHP",
        "IDR",
        "MYR",
        "NZD",
        "PKR",
        "EGP",
        "NGN"
      ],
      "enumTitles": [
        "USD - US Dollar",
        "EUR - Euro",
        "GBP - Pound Sterling",
        "JPY - Japanese Yen",
        "CNY - Chinese Yuan",
        "RUB - Russian Ruble",
        "BRL - Brazilian Real",
