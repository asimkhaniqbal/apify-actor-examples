        "NZD - New Zealand Dollar",
        "PKR - Pakistani Rupee",
        "EGP - Egyptian Pound",
        "NGN - Nigerian Naira"
      ],
      "prefill": "USD",
      "title": "Currency",
      "type": "string"
    },
    "enrichReviews": {
      "default": false,
      "description": "If true, fetch up to maxReviewsPerProduct customer reviews for every product record.",
      "editor": "checkbox",
      "prefill": false,
      "sectionCaption": "Enrichment",
      "title": "Enrich with reviews",
      "type": "boolean"
    },
    "language": {
      "default": "en_US",
      "description": "Locale that AliExpress should render text in (b_locale cookie).",
      "editor": "select",
      "enum": [
        "en_US",
        "es_ES",
        "fr_FR",
        "de_DE",
        "it_IT",
        "pt_BR",
        "pt_PT",
        "ru_RU",
        "ja_JP",
        "ko_KR",
        "ar_MA",
        "tr_TR",
        "th_TH",
        "vi_VN",
        "id_ID",
        "nl_NL",
        "pl_PL",
        "iw_IL"
      ],
      "enumTitles": [
        "English (US)",
        "Spanish (Spain)",
        "French (France)",
        "German (Germany)",
        "Italian (Italy)",
        "Portuguese (Brazil)",
        "Portuguese (Portugal)",
        "Russian (Russia)",
        "Japanese (Japan)",
        "Korean (Korea)",
        "Arabic (Morocco)",
        "Turkish (Turkey)",
        "Thai (Thailand)",
        "Vietnamese (Vietnam)",
        "Indonesian (Indonesia)",
        "Dutch (Netherlands)",
        "Polish (Poland)",
        "Hebrew (Israel)"
      ],
      "prefill": "en_US",
      "title": "UI language",
      "type": "string"
    },
    "maxItems": {
      "default": 25,
      "description": "Hard cap on emitted records.",
      "editor": "number",
      "maximum": 1000,
      "minimum": 1,
      "prefill": 5,
      "sectionCaption": "Limits",
      "title": "Max items",
      "type": "integer"
    },
    "maxPages": {
      "default": 3,
      "description": "Maximum pagination pages per search query (60 items per page).",
      "editor": "number",
      "maximum": 60,
      "minimum": 1,
      "prefill": 3,
      "title": "Max search pages",
      "type": "integer"
    },
    "maxReviewsPerProduct": {
      "default": 0,
      "description": "Cap on how many reviews to keep per product (when enrichReviews=true, or in mode=byReviews). 0 disables.",
      "editor": "number",
      "maximum": 200,
      "minimum": 0,
      "prefill": 0,
      "title": "Max reviews per product",
      "type": "integer"
    },
    "mode": {
      "default": "search",
      "description": "What to scrape. search: text-query results. byProduct: product detail by ID. byStore: store profile by ID. byReviews: customer reviews for product IDs. byUrl: parse any AliExpress URL (search, item, store, or feedback).",
      "editor": "select",
      "enum": [
        "search",
        "byProduct",
        "byStore",
        "byReviews",
        "byUrl"
      ],
      "enumTitles": [
        "Search (text query)",
        "By product ID",
        "By store ID",
        "By reviews",
        "By URL (auto-detect)"
      ],
      "prefill": "search",
      "sectionCaption": "Mode & Inputs",
      "title": "Mode",
      "type": "string"
    },
    "priceMax": {
      "default": 0,
      "description": "Maximum price (in the selected currency). 0 disables the upper bound.",
      "editor": "number",
      "maximum": 1000000,
      "minimum": 0,
      "prefill": 0,
      "title": "Maximum price",
      "type": "integer"
    },
    "priceMin": {
      "default": 0,
      "description": "Minimum price (in the selected currency). Records below this are excluded.",
      "editor": "number",
      "maximum": 1000000,
      "minimum": 0,
      "prefill": 0,
      "title": "Minimum price",
      "type": "integer"
    },
    "productIds": {
      "description": "AliExpress numeric product IDs (e.g. 1005010155028387). Each ID becomes one fetch in byProduct, or one batch of reviews in byReviews.",
      "editor": "stringList",
      "prefill": [
        "1005010155028387"
      ],
      "title": "Product IDs (mode=byProduct or byReviews)",
      "type": "array"
    },
    "proxyConfiguration": {
      "default": {
        "apifyProxyGroups": [],
        "useApifyProxy": true
      },
      "description": "Apify proxy configuration. Used only when useProxy is enabled.",
      "editor": "proxy",
      "prefill": {
        "apifyProxyGroups": [],
        "useApifyProxy": true
      },
      "title": "Proxy configuration",
      "type": "object"
    },
    "ratingMin": {
      "default": 0,
      "description": "Minimum star rating (0–5, accepts decimals like 4.5). Records below are excluded; products with no rating are kept (the user opted into a filter, not into requiring the field).",
      "editor": "number",
      "maximum": 5,
      "minimum": 0,
      "prefill": 0,
      "title": "Minimum rating",
      "type": "number"
    },
    "region": {
      "default": "com",
      "description": "AliExpress regional sub-domain to query. com is the global English storefront; us is the United States storefront; the rest are language-localized variants.",
      "editor": "select",
      "enum": [
        "com",
        "us",
        "ru",
        "es",
        "fr",
        "de",
        "it",
        "nl",
        "pt",
        "pl",
        "ar",
        "tr",
        "ko",
        "ja",
        "vi",
        "th",
        "id",
        "he"
      ],
      "enumTitles": [
        "Global (aliexpress.com)",
        "United States (aliexpress.us)",
        "Russia (aliexpress.com with ru locale)",
        "Spain (es.aliexpress.com)",
        "France (fr.aliexpress.com)",
        "Germany (de.aliexpress.com)",
        "Italy (it.aliexpress.com)",
        "Netherlands (nl.aliexpress.com)",
        "Portugal (pt.aliexpress.com)",
        "Poland (pl.aliexpress.com)",
        "Arabic (ar.aliexpress.com)",
        "Turkey (tr.aliexpress.com)",
        "Korea (ko.aliexpress.com)",
        "Japan (ja.aliexpress.com)",
        "Vietnam (vi.aliexpress.com)",
        "Thailand (th.aliexpress.com)",
        "Indonesia (id.aliexpress.com)",
        "Hebrew (he.aliexpress.com)"
      ],
      "prefill": "com",
      "sectionCaption": "Region & Locale",
      "title": "Regional storefront",
      "type": "string"
    },
    "searchQuery": {
      "description": "Free-text search query, e.g. \"phone case\", \"led strip\", \"running shoes\". Required when mode=search.",
      "editor": "textfield",
      "prefill": "phone case",
      "title": "Search query (mode=search)",
      "type": "string"
    },
