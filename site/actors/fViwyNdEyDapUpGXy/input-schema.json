        "CLP - Chilean Peso",
        "COP - Colombian Peso",
        "PEN - Peruvian Sol",
        "UYU - Uruguayan Peso",
        "ILS - Israeli Shekel",
        "TRY - Turkish Lira",
        "AED - UAE Dirham",
        "SAR - Saudi Riyal",
        "ZAR - South African Rand",
        "PLN - Polish Zloty",
        "CHF - Swiss Franc",
        "SEK - Swedish Krona",
