{
  "description": "Generate real-browser pageviews for your own website with configurable volume, visit depth, dwell, referrer, device mix and per-visit evidence.",
  "properties": {
    "blockAds": {
      "default": true,
      "description": "Block known ad domains. Analytics requests still load so tag firing can be measured.",
      "prefill": false,
      "title": "Block ads",
      "type": "boolean"
    },
    "blockImages": {
      "default": false,
      "description": "Skip images, fonts and media for faster, cheaper visits. Analytics still loads.",
      "prefill": false,
      "title": "Block images",
      "type": "boolean"
    },
    "clickInternalLinks": {
      "default": true,
      "description": "Attempt one visible same-site link per page during human visits. Ads, forms and external links are never clicked.",
      "prefill": false,
      "title": "Click internal links",
      "type": "boolean"
    },
    "customReferrer": {
      "description": "Full http(s) URL used when Referrer is Custom URL.",
      "editor": "textfield",
      "title": "Custom referrer URL",
      "type": "string"
    },
    "deviceMix": {
      "default": "mixed",
      "description": "Device profile for each visit. Mobile and tablet use Android Chromium emulation.",
      "editor": "select",
      "enum": [
        "desktop",
        "mobile",
        "tablet",
        "mixed"
      ],
      "enumTitles": [
        "Desktop",
        "Mobile",
        "Tablet",
        "Mixed"
      ],
      "prefill": "desktop",
      "title": "Device mix",
      "type": "string"
    },
    "dwellSeconds": {
      "default": 20,
      "description": "Target seconds on each page for human visits, varied slightly. Internal clicks may extend the measured time. Ignored by quick style.",
      "maximum": 300,
      "minimum": 1,
      "prefill": 1,
      "title": "Dwell (seconds)",
      "type": "integer"
    },
    "pagesPerVisit": {
      "default": 1,
      "description": "Maximum pages in one visit (1-10), subject to the total pageview budget; above 1 attempts same-site link clicks when clicks are enabled.",
      "maximum": 10,
      "minimum": 1,
      "prefill": 1,
      "title": "Pages per visit",
      "type": "integer"
    },
    "pageviews": {
      "default": 10,
      "description": "Total page loads to attempt, including followed pages. 1-1000.",
      "maximum": 1000,
      "minimum": 1,
      "prefill": 1,
      "title": "Pageviews",
      "type": "integer"
    },
    "referrerMode": {
      "default": "direct",
      "description": "Referrer shown to the site: direct, search engine, social network, or a custom URL.",
      "editor": "select",
      "enum": [
        "direct",
        "search",
        "social",
        "custom"
      ],
      "enumTitles": [
        "Direct (no referrer)",
        "Search engine",
        "Social network",
        "Custom URL"
      ],
      "prefill": "direct",
      "title": "Referrer",
      "type": "string"
    },
    "scroll": {
      "default": true,
      "description": "Scroll each page during human visits. Scroll depth is omitted when scrolling is off or no range is measurable; a very short page with a tiny overflow can report 100.",
      "prefill": false,
      "title": "Scroll pages",
      "type": "boolean"
    },
    "targetUrls": {
      "description": "Public pages you own or are authorized to test. Legacy startUrls is accepted when this is empty.",
      "editor": "requestListSources",
      "prefill": [
        {
          "url": "https://example.com"
        }
      ],
      "title": "Target URLs",
      "type": "array"
    },
    "utmSource": {
      "description": "Optional utm_source label appended to target URLs, e.g. traffic-test. Recommended to mark test visits.",
      "editor": "textfield",
      "title": "Test-source tag (utm_source)",
      "type": "string"
    },
