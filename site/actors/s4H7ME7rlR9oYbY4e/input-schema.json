{
  "description": "Look up Wikipedia articles by URL, exact title, keyword search or category, in any language edition. Optional enrichment adds full text, sections, links, references and pageviews.",
  "properties": {
    "articleTitles": {
      "description": "Exact article titles to look up in the selected language edition. Spaces or underscores are both accepted; redirects are followed. Example: Albert Einstein.",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "title": "Article titles",
      "type": "array"
    },
    "articleUrls": {
      "description": "Wikipedia article URLs to look up. Works with desktop, mobile and index.php URLs, and with any language edition. Example: https://en.wikipedia.org/wiki/Albert_Einstein",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "prefill": [
        "https://en.wikipedia.org/wiki/Python_(programming_language)"
      ],
      "sectionCaption": "Articles to look up",
      "title": "Article URLs",
      "type": "array"
    },
    "categoryNames": {
      "description": "Wikipedia category names to browse, with or without the Category: prefix. Each member page becomes an article record.",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "sectionCaption": "Category browsing",
      "title": "Categories",
      "type": "array"
    },
    "includeExternalLinks": {
      "default": false,
      "description": "Add the outbound external URLs cited or listed by the article in externalLinks.",
      "prefill": false,
      "title": "Include external links",
      "type": "boolean"
    },
    "includeFullContent": {
      "default": false,
      "description": "Add the complete article body as plain text in fullText (not only the lead summary).",
      "prefill": false,
      "title": "Include full article text",
      "type": "boolean"
    },
    "includeLinks": {
      "default": false,
      "description": "Add the titles of other Wikipedia articles linked from the article in links.",
      "prefill": false,
      "title": "Include internal links",
      "type": "boolean"
    },
    "includePageviews": {
      "default": false,
      "description": "Add a pageview series and total in pageviews, from Wikimedia's pageview API.",
      "prefill": false,
      "title": "Include pageviews",
      "type": "boolean"
    },
    "includeReferences": {
      "default": false,
      "description": "Add the number of inline citations in referencesCount.",
      "prefill": false,
      "title": "Include reference count",
      "type": "boolean"
    },
    "includeSections": {
      "default": false,
      "description": "Add the article's heading outline (title, level, anchor) in sections.",
      "prefill": false,
      "title": "Include section outline",
      "type": "boolean"
    },
