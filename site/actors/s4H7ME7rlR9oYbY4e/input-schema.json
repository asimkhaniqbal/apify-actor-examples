      "prefill": "en",
      "sectionCaption": "Options",
      "title": "Language edition",
      "type": "string"
    },
    "maxArticlesPerCategory": {
      "default": 20,
      "description": "Maximum category members to fetch for each category (1-500).",
      "maximum": 500,
      "minimum": 1,
      "prefill": 20,
      "title": "Max articles per category",
      "type": "integer"
    },
    "maxArticlesPerQuery": {
      "default": 5,
      "description": "Maximum search results to fetch for each query (1-500).",
      "maximum": 500,
      "minimum": 1,
      "prefill": 5,
      "title": "Max articles per search query",
      "type": "integer"
    },
    "maxItems": {
      "default": 100,
      "description": "Hard cap on total article records emitted across all modes.",
      "maximum": 10000,
      "minimum": 1,
      "prefill": 100,
      "title": "Max articles",
      "type": "integer"
    },
    "pageviewsGranularity": {
      "default": "monthly",
      "description": "Monthly or daily pageview points. Used when Include pageviews is on.",
      "editor": "select",
      "enum": [
        "monthly",
        "daily"
      ],
      "enumTitles": [
        "Monthly",
        "Daily"
      ],
      "prefill": "monthly",
      "title": "Pageview granularity",
      "type": "string"
    },
    "pageviewsPeriods": {
      "default": 12,
      "description": "Number of pageview periods to return: 1-12 months for monthly, or 1-365 days for daily.",
      "maximum": 365,
      "minimum": 1,
      "prefill": 12,
      "title": "Pageview periods",
      "type": "integer"
    },
    "searchQueries": {
      "description": "Keywords to search with Wikipedia's full-text search. Returns the top-ranked matching articles per query.",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "sectionCaption": "Keyword search",
      "title": "Search queries",
      "type": "array"
    }
  },
