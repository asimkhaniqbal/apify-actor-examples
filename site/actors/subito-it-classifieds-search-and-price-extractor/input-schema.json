      "prefill": false,
      "title": "Shippable only",
      "type": "boolean"
    },
    "sort": {
      "default": "relevance",
      "description": "Result ordering.",
      "editor": "select",
      "enum": [
        "relevance",
        "datedesc",
        "priceasc",
        "pricedesc"
      ],
      "enumTitles": [
        "Relevance",
        "Newest first",
        "Price: low to high",
        "Price: high to low"
      ],
      "prefill": "relevance",
      "title": "Sort by",
      "type": "string"
    },
    "startUrls": {
      "description": "(mode=searchByUrls) Subito.it ad URLs (...-123456789.htm) and/or search-result URLs (/annunci-lazio/vendita/auto/?q=bmw).",
      "editor": "requestListSources",
      "items": {
        "properties": {
          "url": {
            "description": "Subito.it listing or search-result URL.",
            "title": "URL",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "type": "object"
      },
      "title": "Listing or search URLs",
      "type": "array"
    },
    "titleOnly": {
      "default": false,
      "description": "Match the keyword against listing titles instead of title and description.",
      "prefill": false,
      "title": "Search titles only",
      "type": "boolean"
    },
    "urgentOnly": {
      "default": false,
      "description": "Only listings marked urgent (mainly job ads).",
      "prefill": false,
      "title": "Urgent only",
      "type": "boolean"
    }
  },
  "required": [
    "mode"
  ],
  "schemaVersion": 1,
  "title": "Subito.it Scraper Input",
