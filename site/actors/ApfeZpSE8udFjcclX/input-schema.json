{
  "description": "Search live startup.jobs listings by category, role, keyword, location, company, salary, experience and work mode.",
  "properties": {
    "category": {
      "default": "remote",
      "description": "Broad job category. Choose All categories to search everything, or Remote jobs for remote-only listings.",
      "editor": "select",
      "enum": [
        "all",
        "engineering",
        "design",
        "marketing",
        "sales",
        "product",
        "operations",
        "data",
        "finance",
        "hr",
        "legal",
        "customer-success",
        "remote"
      ],
      "enumTitles": [
        "All categories",
        "Engineering",
        "Design",
        "Marketing",
        "Sales",
        "Product",
        "Operations",
        "Data and analytics",
        "Finance and accounting",
        "Human resources",
        "Legal",
        "Customer success",
        "Remote jobs"
      ],
      "prefill": "remote",
      "title": "Job category",
      "type": "string"
    },
    "company": {
      "description": "Company name, slug or startup.jobs company URL (e.g. stripe or https://startup.jobs/company/stripe).",
      "editor": "textfield",
      "title": "Company",
      "type": "string"
    },
    "employmentType": {
      "default": "",
      "description": "Filter by full-time, part-time, contract or internship roles.",
      "editor": "select",
      "enum": [
        "",
        "full-time",
        "part-time",
        "contractor",
        "internship"
      ],
      "enumTitles": [
        "Any employment type",
        "Full-time",
        "Part-time",
        "Contract",
        "Internship"
      ],
      "prefill": "",
      "title": "Employment type",
      "type": "string"
    },
    "experienceLevel": {
      "default": "",
      "description": "Filter by the experience range published on the listing. Jobs without an experience level are excluded when this is set.",
      "editor": "select",
      "enum": [
        "",
        "0-1",
        "1-3",
        "3-6",
        "6+"
      ],
      "enumTitles": [
        "Any experience",
        "0-1 years",
        "1-3 years",
        "3-6 years",
        "6+ years"
      ],
      "prefill": "",
      "title": "Experience level",
      "type": "string"
    },
    "keyword": {
      "description": "Matches job titles, company names and tags on startup.jobs. It does not search full description text.",
      "editor": "textfield",
      "title": "Search keyword",
      "type": "string"
    },
    "location": {
      "description": "City or country name, or a startup.jobs location URL (e.g. United States, London, https://startup.jobs/locations/germany). Use Remote for remote jobs.",
      "editor": "textfield",
      "title": "Location",
      "type": "string"
    },
    "maxItems": {
      "default": 50,
      "description": "Maximum number of jobs to return (1-500).",
      "maximum": 500,
      "minimum": 1,
      "prefill": 2,
      "title": "Max items",
      "type": "integer"
    },
    "maxSalaryUsd": {
      "description": "Only jobs whose published minimum salary is at most this amount in USD. Jobs without a published salary are excluded.",
      "maximum": 1000000,
      "minimum": 0,
      "title": "Maximum salary (USD)",
      "type": "integer"
    },
    "minSalaryUsd": {
      "description": "Only jobs whose published maximum salary is at least this amount in USD. Jobs without a published salary are excluded.",
      "maximum": 1000000,
      "minimum": 0,
      "title": "Minimum salary (USD)",
      "type": "integer"
    },
    "postedWithin": {
      "default": "",
      "description": "Only include jobs published within this period.",
      "editor": "select",
      "enum": [
        "",
        "1",
        "7",
        "30",
        "90"
      ],
      "enumTitles": [
        "Any time",
        "Last 24 hours",
        "Last 7 days",
        "Last 30 days",
        "Last 90 days"
      ],
      "prefill": "",
      "title": "Posted within",
      "type": "string"
    },
    "role": {
      "default": "",
