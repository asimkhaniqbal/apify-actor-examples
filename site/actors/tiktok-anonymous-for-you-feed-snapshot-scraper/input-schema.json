{
  "description": "Capture an anonymous snapshot of TikTok's For You feed. No cookies, login, or proxy configuration required.",
  "properties": {
    "excludeAds": {
      "default": false,
      "description": "Drop posts that TikTok marks as advertisements.",
      "prefill": false,
      "title": "Exclude Ads",
      "type": "boolean"
    },
    "maxItems": {
      "default": 30,
      "description": "Maximum number of For You posts to collect. Set to 0 to return no items.",
      "maximum": 300,
      "minimum": 0,
      "prefill": 3,
      "title": "Maximum Posts",
      "type": "integer"
    },
    "minPlayCount": {
      "default": 0,
      "description": "Drop posts with fewer plays than this value. 0 disables the filter.",
      "maximum": 1000000000,
      "minimum": 0,
      "prefill": 0,
      "title": "Minimum Play Count",
      "type": "integer"
    },
    "postedWithinDays": {
      "default": 0,
      "description": "Only keep posts created in the last N days. 0 disables the filter.",
      "maximum": 365,
      "minimum": 0,
      "prefill": 0,
      "title": "Posted Within (Days)",
      "type": "integer"
    },
    "region": {
      "default": "AUTO",
      "description": "Market hint for the feed. AUTO follows the connection region. A selected market asks TikTok for that market and uses a matching datacenter exit when one is available; TikTok may still override the hint.",
